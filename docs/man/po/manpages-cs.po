#, no-wrap
msgid "aMuleGUI"
msgstr "aMuleGUI"

#. type: Plain text
#: amulegui.1.in
msgid "amulegui - aMule control program with GUI"
msgstr ""

#. type: Plain text
#: amulegui.1.in
msgid "B<amulegui> is a client program, and can be connected to amule or amuled via EC. You can manage your amule program with it. It provides almost the same functionalities as amule, even if the core works on another computer."
msgstr ""

#. type: Plain text
#: amulegui.1.in
msgid "Write logs to the specified filename instead of the default log file.  Overrides the B<LogFilePath> setting under B<[eMule]> in I<remote.conf> for this run only.  Relative paths are resolved against the configuration directory.  The parent directory must already exist and be writable; it is not created automatically.  An empty or absent configuration setting uses I<remotelogfile> in the configuration directory.  On startup, the previous log is backed up to the same path with I<.bak> appended.  If the backup cannot be created, a warning is logged and the current session is appended to the existing log.  Configuration changes take effect after restart."
msgstr "Zapsat logy do zadaného souboru namísto výchozího souboru logu.  Toto nastavení přepisuje nastavení B<LogFilePath> v sekci B<[eMule]> v I<remote.conf>, a to pouze pro toto spuštění.  Relativní cesty se vyhodnocují vzhledem ke konfiguračnímu adresáři.  Nadřazený adresář musí již existovat a musí být zapisovatelný; nevytváří se automaticky.  Pokud je toto nastavení konfigurace prázdné nebo chybí, použije se I<remotelogfile> v konfiguračním adresáři.  Při spuštění se předchozí log zálohuje do stejné cesty a bude mít příponu I<.bak>.  Pokud nelze zálohu vytvořit, zaznamená se varování a aktuální relace se připojí k existujícímu logu.  Změny v konfiguraci se projeví až po restartu."

#. type: Plain text
#: amulegui.1.in
msgid "Skip connection dialog."
msgstr ""

#. type: Plain text
#: amulegui.1.in
msgid "Enable or disable starting amulegui on user login, then exit.  The OS-specific store is selected automatically: Windows registry Run key, macOS LaunchAgent, Linux XDG I<.desktop> autostart entry."
msgstr ""

