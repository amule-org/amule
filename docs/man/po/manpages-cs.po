#, no-wrap
msgid "aMuleCmd v@PACKAGE_VERSION@"
msgstr "aMuleCmd v@PACKAGE_VERSION@"

#. type: TH
#: amulecmd.1.in ed2k.1.in ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "aMule utilities"
msgstr "aMule nástroje"

#. type: Plain text
#: amulecmd.1.in
msgid "amulecmd - Console-based program to control aMule"
msgstr "amulecmd - Konzolový program pro kontrolu aMule"

#. type: Plain text
#: amulecmd.1.in
msgid "[B<-h> I<E<lt>hostE<gt>>] [B<-p> I<E<lt>portE<gt>>]"
msgstr "[B<-h> I<E<lt>hostitelE<gt>>] [B<-p> I<E<lt>portE<gt>>]"

#. type: Plain text
#: amulecmd.1.in
msgid "[B<-f> I<E<lt>pathE<gt>>]"
msgstr "[B<-f> I<E<lt>cestaE<gt>>]"

#. type: Plain text
#: amulecmd.1.in
msgid "[B<-l> I<E<lt>langE<gt>>] {B< >[B<-w>]B< >|B< >[B<-c> I<E<lt>commandE<gt>>]B< >}"
msgstr "[B<-l> I<E<lt>jazykE<gt>>] {B< >[B<-w>]B< >|B< >[B<-c> I<E<lt>příkazE<gt>>]B< >}"

#. type: Plain text
#: amulecmd.1.in
msgid "B<amulecmd> is a console-based client to control aMule."
msgstr "B<amulecmd> je konzolový klient pro kontrolu aMule."

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<[ -h> I<E<lt>hostE<gt>>, B<--host>=I<E<lt>hostE<gt>> B<]>"
msgstr "B<[ -h> I<E<lt>hostitelE<gt>>, B<--host>=I<E<lt>hostitelE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in
msgid "Host where aMule is running (default: I<127.0.0.1>).  I<E<lt>hostE<gt>> might be an IP address or a DNS name"
msgstr "Hostitel, na kterém aMule běží (výchozí: I<127.0.0.1>). I<E<lt>hostitelE<gt>> může být IP adresa nebo DNS jméno"

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<[ -p> I<E<lt>portE<gt>>, B<--port>=I<E<lt>portE<gt>> B<]>"
msgstr "B<[ -p> I<E<lt>portE<gt>>, B<--port>=I<E<lt>portE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in
msgid "aMule's port for External Connections, as set in Preferences-E<gt>Remote Controls (default: I<4712>)"
msgstr "aMule port pro externí připojení, jak je nastaven v Nastavení-E<gt>Vzdálené ovládání (výchozí: I<4712>)"

#. type: Plain text
#: amulecmd.1.in
msgid "Read the External Connections password from the first line of stdin. Input is hidden on a terminal. Later lines stay on stdin, where amulecmd reads its commands. With B<-w> it replaces a saved password, even when an older file holds two. Without this option and without a saved password, amulecmd asks for the password the same way, so piped input then also starts with the password."
msgstr "Číst heslo pro externí připojení z prvního řádku standardního vstupu (stdin). Vstup je na terminálu skryt. Následující řádky zůstávají na standardním vstupu, odkud amulecmd čte své příkazy. Pomocí volby B<-w> dojde k nahrazení uloženého hesla, a to i v případě, že starší soubor obsahuje dvě hesla. Bez této volby a bez uloženého hesla si amulecmd vyžádá heslo stejným způsobem, takže vstup přes rouru (pipe) pak také začíná heslem."

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<[ -f> I<E<lt>pathE<gt>>, B<--config-file>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ -f> I<E<lt>cestaE<gt>>, B<--konfigurační-soubor>=I<E<lt>cestaE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in
msgid "Use the given configuration file.  Default configuration file is I<~/.aMule/remote.conf>"
msgstr "Použít zadaný konfigurační soubor.  Výchozí konfigurační soubor je I<~/.aMule/remote.conf>"

#. type: Plain text
#: amulecmd.1.in
msgid "Do not print any output to stdout."
msgstr "Nevypisovat nic na standardní výstup."

#. type: Plain text
#: amulecmd.1.in
msgid "Be verbose - show also debug messages."
msgstr "Zapnout podrobný výstup včetně ladicích zpráv."

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<[ -l> I<E<lt>langE<gt>>, B<--locale>=I<E<lt>langE<gt>> B<]>"
msgstr "B<[ -l> I<E<lt>jazykE<gt>>, B<--locale>=I<E<lt>jazykE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in
msgid "Sets program locale (language).  See the B<NOTES> section for the description of the I<E<lt>langE<gt>> parameter."
msgstr "Nastaví jazykové prostředí programu (jazyk). Viz sekce B<POZNÁMKY> pro popis parametru I<E<lt>jazykE<gt>>."

#. type: Plain text
#: amulecmd.1.in
msgid "Write command line options to config file and exit"
msgstr "Zapsat předvolby z příkazového řádku do konfiguračního souboru a ukončit"

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<[ -c> I<E<lt>commandE<gt>>, B<--command>=I<E<lt>commandE<gt>> B<]>"
msgstr "B<[ -c> I<E<lt>příkazE<gt>>, B<--command>=I<E<lt>příkazE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in
msgid "Execute I<E<lt>commandE<gt>> as if it was entered at amulecmd's prompt and exit."
msgstr "Spustit I<E<lt>příkazE<gt>> tak, jako kdyby byl zadán na příkazovou řádku v amulecmd a ukončit."

#. type: Plain text
#: amulecmd.1.in
msgid "Force ZLIB compression on the External Connection link regardless of the dialed-IP locality.  Useful when the server side is reachable over a VPN tunnel that resolves to a LAN IP and the heuristic would otherwise skip compression."
msgstr "Vynutit ZLIB kompresi u odkazu externího připojení, bez ohledu na umístění vytáčené IP adresy. Užitečné, když je serverová strana dostupná přes VPN tunel, který je veden na LAN IP a heuristika by jinak přeskočila kompresi."

#. type: Plain text
#: amulecmd.1.in
msgid "Separate the fields of the list commands with spaces, as earlier versions did, instead of tabs.  Client names and file names may contain spaces, so the default tab separator is what lets a script split a row back into its fields; use this only for scripts written against the older output."
msgstr "Oddělit mezerami pole seznamových příkazů, tak jak to bylo u starších verzí, namísto oddělení tabulátory. Názvy klientů a souborů mohou obsahovat mezery, takže výchozí separátor karet je to, co umožňuje skriptu rozdělit řádek zpět do jednotlivých polí; použijte toto pouze pro skripty psané pro starší výstup."

#. type: SH
#: amulecmd.1.in
#, no-wrap
msgid "COMMANDS"
msgstr "PŘÍKAZY"

#. type: Plain text
#: amulecmd.1.in
msgid "All commands are case insensitive."
msgstr "Všechny příkazy jsou citlivé na velikost písmen."

#. type: Plain text
#: amulecmd.1.in
msgid "Adds an eD2k-link or a magnet-link to the core."
msgstr "Přidá eD2k odkaz nebo magnet odkaz do jádra."

#. type: Plain text
#: amulecmd.1.in
msgid "a serverlist link, in which case all servers in the list will be added to the server list."
msgstr "odkaz na seznam serverů, v tomto případě všechny servery budou přidány do seznamu serverů."

#. type: Plain text
#: amulecmd.1.in
msgid "The magnet link must contain the eD2k hash and file length."
msgstr "Odkaz magnet musí obsahovat eD2k hash a délku souboru."

#. type: Plain text
#: amulecmd.1.in
msgid "Cancels the download specified by I<E<lt>hashE<gt>> or I<E<lt>numberE<gt>>. To get the value use B<show>."
msgstr "Zruší stahování stanovené podle I<E<lt>hashE<gt>> nebo I<E<lt>čísloE<gt>>. Pro získání hodnoty použijte B<show>."

#. type: Plain text
#: amulecmd.1.in
msgid "Connect to the network."
msgstr "Připojit se k síti."

#. type: Plain text
#: amulecmd.1.in
msgid "This will connect to all networks that are enabled in Preferences."
msgstr "Toto způsobí připojení ke všem sítím, které jsou povolené v Nastavení."

#. type: Plain text
#: amulecmd.1.in
msgid "With the optional parameter you can specify which network to connect to. Giving a server address in the form of IP:Port (where IP is either a dotted decimal IPv4 address or a resolvable DNS name) aMule will connect to that server only."
msgstr "Pomocí volitelného parametru můžete určit, ke které síti se připojit. Zadáním adresy serveru ve formě IP:Port (kde IP je buď decimální adresa IPv4, nebo jméno hostitele, vyřešitelné pomocí DNS) se aMule připojí jen k tomuto serveru."

#. type: Plain text
#: amulecmd.1.in
msgid "Disconnect from all networks you are connected to, or just disconnect from the specified network."
msgstr "Odpojte se od všech sítí, ke kterým jste připojeni, nebo se odpojte jen od zadané sítě."

#. type: Plain text
#: amulecmd.1.in
msgid "Start downloading a file."
msgstr "Začít stahovat soubor"

#. type: Plain text
#: amulecmd.1.in
msgid "Give the I<E<lt>numberE<gt>> of a file as listed by B<results>, optionally followed by a search I<E<lt>idE<gt>> (as printed by B<search>). Without an id, the number refers to the last B<results> output, or to the most recently started search if nothing was listed yet.  Example: 'download 12' downloads file 12 of the last results; 'download 12 3' downloads file 12 of search 3."
msgstr "Zadejte I<E<lt>čísloE<gt>> souboru ze seznamu B<results>, volitelně připište I<E<lt>idE<gt>> vyhledávání (které vrátilo B<search>). Bez id zadané číslo představuje výstup posledních B<results>, nebo naposledy zahájené vyhledávání, pokud ještě nebylo nic v seznamu.  Příklad: 'download 12' stáhne soubor 12 posledních výsledků; 'download 12 3' stáhne soubor 12 z vyhledávání 3."

#. type: Plain text
#: amulecmd.1.in
msgid "Disconnect from amule/amuled and quit amulecmd."
msgstr "Odpojit od amule/amuled a ukončit amulecmd."

#. type: Plain text
#: amulecmd.1.in
msgid "Get and display a preference value."
msgstr "Získat a zobrazit hodnotu předvolby."

#. type: Plain text
#: amulecmd.1.in
msgid "Available values for I<E<lt>whatE<gt>>:"
msgstr "Dostupné hodnoty pro I<E<lt>coE<gt>>:"

#. type: Plain text
#: amulecmd.1.in
msgid "Get bandwidth limits."
msgstr "Získejte limity šířky pásma."

#. type: Plain text
#: amulecmd.1.in
msgid "Get IPFilter preferences."
msgstr "Získat nastavení IPFilter."

#. type: Plain text
#: amulecmd.1.in
msgid "Prints a short usage description.  If called without parameter, it shows a list of available commands.  If called with I<E<lt>commandE<gt>>, it shows a short description of the given command."
msgstr "Vypíše krátký popis použití.  Pokud není uveden parametr, vypíše seznam dostupných příkazů.  Pokud je uvedeno s I<E<lt>příkazE<gt>>, ukáže krátký popis daného příkazu."

#. type: Plain text
#: amulecmd.1.in
msgid "Pauses the download specified by I<E<lt>hashE<gt>> or I<E<lt>numberE<gt>>. To get the value use B<show>."
msgstr "Pozastaví stahování stanovené podle I<E<lt>hashE<gt>> nebo I<E<lt>čísloE<gt>>. Pro získání hodnoty použijte B<show>."

#. type: Plain text
#: amulecmd.1.in
msgid "Set priority of a download specified by I<E<lt>hashE<gt>> or I<E<lt>numberE<gt>>."
msgstr "Nastavit prioritu stahování, určeného pomocí I<E<lt>hashE<gt>> nebo I<E<lt>čísloE<gt>>."

#. type: Plain text
#: amulecmd.1.in
msgid "Available values for I<E<lt>priorityE<gt>>:"
msgstr "Dostupné hodnoty pro I<E<lt>prioritaE<gt>>:"

#. type: Plain text
#: amulecmd.1.in
msgid "Automatic priority."
msgstr "Automatická priorita."

#. type: Plain text
#: amulecmd.1.in
msgid "High priority."
msgstr "Vysoká priorita."

#. type: Plain text
#: amulecmd.1.in
msgid "Low priority."
msgstr "Nízká priorita."

#. type: Plain text
#: amulecmd.1.in
msgid "Normal priority."
msgstr "Normální priorita."

#. type: Plain text
#: amulecmd.1.in
msgid "Shows the progress of an on-going search. Optionally takes a search I<E<lt>idE<gt>> (as printed by B<search>); with no id, shows the most recently started search."
msgstr "Ukáže průběh aktuálního vyhledávání. Volitelně přijímá parametr I<E<lt>idE<gt>> (zobrazený pomocí B<search>); bez id zobrazí naposledy zahájené vyhledávání."

#. type: Plain text
#: amulecmd.1.in
msgid "A synonym of the B<exit> command."
msgstr "Synonymum příkazu B<exit>."

#. type: Plain text
#: amulecmd.1.in
msgid "Reloads a given object."
msgstr "Znovu načte zadaný objekt."

#. type: Plain text
#: amulecmd.1.in
msgid "Reload shared files list."
msgstr "Znovu načíst seznam sdílených souborů."

#. type: Plain text
#: amulecmd.1.in
msgid "Reload IP filter tables."
msgstr "Znovu načíst tabulky IP filtru"

#. type: Plain text
#: amulecmd.1.in
msgid "Reset the log."
msgstr "Resetovat log."

#. type: Plain text
#: amulecmd.1.in
msgid "Shows you the results of a search. Optionally takes a search I<E<lt>idE<gt>> (as printed by B<search>); with no id, shows the most recently started search.  Several searches can be kept on the daemon at once and addressed by id."
msgstr "Ukáže vám výsledky vyhledávání. Volitelně připište I<E<lt>idE<gt>> vyhledávání (které vrátil B<search>); bez id zobrazí naposledy zahájené vyhledávání.  Na daemonu může být několik vyhledávání zároveň a je možné je adresovat pomocí id."

#. type: Plain text
#: amulecmd.1.in
msgid "Resumes the download specified by I<E<lt>hashE<gt>> or I<E<lt>numberE<gt>>. To get the value use B<show>."
msgstr "Obnoví stahování stanovené podle I<E<lt>hashE<gt>> nebo I<E<lt>čísloE<gt>>. Pro získání hodnoty použijte B<show>."

#. type: Plain text
#: amulecmd.1.in
msgid "Lists retained search IDs and queries, including searches started by other clients."
msgstr "Vypisuje seznam dostupných ID vyhledávání a požadavků, včetně vyhledávání zahájených jinými klienty."

#. type: Plain text
#: amulecmd.1.in
msgid "Stops activity for the specified search while retaining its results."
msgstr "Zastaví aktivitu zadaného vyhledávání a zachová jeho výsledky."

#. type: Plain text
#: amulecmd.1.in
msgid "Requests more Kad results for the specified search. Further results are not guaranteed.  The reply reports whether later requests remain possible, or whether that information is unavailable from an older daemon."
msgstr "Požádá o více výsledků zadaného vyhledávání Kad. Další výsledky ale nejsou zaručeny.  Odpověď sdělí, zda jsou možné další žádosti a nebo zda je tato informace nedostupná pod starším daemonem."

#. type: Plain text
#: amulecmd.1.in
msgid "These management commands require daemon support for search listing and multiple searches.  Use an explicit ID from B<search list> for stop and more."
msgstr "Tyto příkazy pro správu vyžadují podporu daemona pro výpis vyhledávání a mnohočetné vyhledávání. Použijte explicitně ID z B<search list> pro zastavení a další."

#. type: Plain text
#: amulecmd.1.in
msgid "Makes a search for the given I<E<lt>keywordE<gt>>. A search type and a keyword to search is mandatory to do this.  Example: 'search kad amule' performs a kad search for 'amule'.  Prints a search id; pass it to B<results> or B<progress> to address this search. Several searches can run at once, each with its own id."
msgstr "Vyhledá zadané I<E<lt>klíčové slovoE<gt>>. Typ vyhledávání a klíčové slovo je nutné uvést. Příklad: 'search kad amule' provede hledání v Kad pro slovo 'amule'. Vrátí id vyhledávání; předá ho do B<results> nebo B<progress> pro vyřešení tohoto vyhledávání. V jednu chvíli může běžet více vyhledávání, každé s vlastním id."

#. type: Plain text
#: amulecmd.1.in
msgid "Available search types:"
msgstr "Dostupné typy vyhledávání:"

#. type: Plain text
#: amulecmd.1.in
msgid "Searches eD2k and Kad together, using the available network if the other cannot start. Requires a daemon advertising All search support; older daemons return a clear error without starting a search. Example: 'search all amule'."
msgstr "Prohledá eD2k a Kad zároveň, pomocí dostupné sítě, pokud se druhá nespustí. Vyžaduje daemon s podporu Vyhledávání všude; starší daemons vrátí chybu bez spuštění vyhledávání. Příklad: \"search all amule\"."

#. type: Plain text
#: amulecmd.1.in
msgid "Performs a global search."
msgstr "Provede globální vyhledávání."

#. type: Plain text
#: amulecmd.1.in
msgid "Performs a search on the Kademlia network."
msgstr "Provede vyhledávání v síti Kademlia."

#. type: Plain text
#: amulecmd.1.in
msgid "Performs a local search."
msgstr "Provede místní vyhledávání."

#. type: Plain text
#: amulecmd.1.in
msgid "Optional filters can be placed before, after, or interleaved with the search keyword(s):"
msgstr "Volitelné filtry mohou být umístěny před, za, nebo mezi vyhledávaná slova:"

#. type: Plain text
#: amulecmd.1.in
msgid "Restrict results to the given file type."
msgstr "Omezit výsledky na daný typ souboru."

#. type: Plain text
#: amulecmd.1.in
msgid "Restrict results to a specific file extension (e.g.\\ I<iso>, I<mp3>)."
msgstr "Omezit výsledky na určitou koncovku souboru (např.\\ I<iso>, I<mp3>)."

#. type: Plain text
#: amulecmd.1.in
msgid "Minimum number of sources a result must report."
msgstr "Minimální počet zdrojů které výsledek musí mít."

#. type: Plain text
#: amulecmd.1.in
msgid "Smallest file size to return. Suffixes use binary multipliers (K = 1024, M = K\\(mu1024, G = M\\(mu1024); no suffix means bytes."
msgstr "Nejnižší velikost souboru k zobrazení. Přípony používají binární multiplikátory (K = 1024, M = K\\(mu1024, G = M\\(mu1024); žádný suffix znamená bajty."

#. type: Plain text
#: amulecmd.1.in
msgid "Largest file size to return. Same suffixes as B<--min-size>."
msgstr "Nejvyšší velikost souboru k zobrazení. Stejné přípony jako B<-min-size>."

#. type: Plain text
#: amulecmd.1.in
msgid "Media filters:"
msgstr "Mediální filtry:"

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<--min-bitrate> I<E<lt>kbpsE<gt>>"
msgstr "B<--min-bitrate> I<E<lt>kbpsE<gt>>"

#. type: Plain text
#: amulecmd.1.in
msgid "Minimum bitrate as a whole number from 0 to 1000000."
msgstr "Minimální datový tok jako celé číslo od 0 do 1000000."

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<--min-duration> I<E<lt>secondsE<gt>>"
msgstr "B<--min-duration> I<E<lt>sekundyE<gt>>"

#. type: Plain text
#: amulecmd.1.in
msgid "Minimum duration as a whole number from 0 to 86400."
msgstr "Minimální doba trvání jako celé číslo od 0 do 86400."

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<--codec>, B<--title>, B<--album>, B<--artist> I<E<lt>textE<gt>>"
msgstr "B<--codec>, B<--title>, B<--album>, B<--artist> I<E<lt>textE<gt>>"

#. type: Plain text
#: amulecmd.1.in
msgid "Each option takes a text value. Enclose values containing spaces in single or double quotes.  When using B<-c>, preserve those quotes inside the command string passed by the shell."
msgstr "Každá volba přijímá textovou hodnotu. Hodnoty obsahující mezery ohraničte jednoduchými nebo dvojitými uvozovkami.  Při použití B<-c>, zachovat tyto uvozovky v řetězci příkazu předanému příkazové řádce."

#. type: Plain text
#: amulecmd.1.in
msgid "Zero or empty media values impose no constraint. Nonempty media filters require daemon support. Kad applies these filters; eD2k servers may ignore them."
msgstr "Nulové nebo prázdné mediální hodnoty nezpůsobí žádné omezení výsledků. Mediální filtry, které nejsou prázdné vyžadují podporu daemona. Kad tyto filtry použije; eD2k servery je mohou ignorovat."

#. type: Plain text
#: amulecmd.1.in
msgid "Example: 'search global linux iso --type Iso --min-size 100M' returns results for 'linux iso' of file-type Iso at least 100 MiB."
msgstr "Příklad: 'search global linux iso --type Iso --min-size 100M' vrátí výsledky pro 'linux iso' typu souboru Iso nejméně 100 MiB velké."

#. type: Plain text
#: amulecmd.1.in
msgid "Sets a given preferences value."
msgstr "Nastaví danou hodnotu předvoleb."

#. type: Plain text
#: amulecmd.1.in
msgid "Set bandwidth limits."
msgstr "Nastavit limity šířky pásma."

#. type: Plain text
#: amulecmd.1.in
msgid "Set IPFilter preferences."
msgstr "Nastavit předvolby IPFiltru."

#. type: Plain text
#: amulecmd.1.in
msgid "Shows upload/download queue, servers list or shared files list."
msgstr "Zobrazí frontu odesílání/stahování, seznam serverů nebo seznam sdílených souborů."

#. type: Plain text
#: amulecmd.1.in
msgid "Show download queue."
msgstr "Zobrazit frontu stahování."

#. type: Plain text
#: amulecmd.1.in
msgid "Show log."
msgstr "Zobrazit protokol."

#. type: Plain text
#: amulecmd.1.in
msgid "Show servers list."
msgstr "Zobrazit seznam serverů."

#. type: Plain text
#: amulecmd.1.in
msgid "Show shared files list."
msgstr "Zobrazit seznam sdílených souborů."

#. type: Plain text
#: amulecmd.1.in
msgid "Show upload queue."
msgstr "Zobrazit frontu odesílání."

#. type: Plain text
#: amulecmd.1.in
msgid "Shutdown the remote running core (amule/amuled).  This will also shut down the text client, since it is unusable without a running core."
msgstr "Vypnout vzdálené běžící jádro (amule/amuled).  Vypne se i textový klient, protože je bez běžícího jádra nepoužitelný."

#. type: Plain text
#: amulecmd.1.in
msgid "Show statistics tree."
msgstr "Zobrazit strom statistik."

#. type: Plain text
#: amulecmd.1.in
msgid "The optional I<E<lt>numberE<gt>> in the range of 0-255 can be passed as argument to this command, which tells how many entries of the client version subtree should be shown. Passing 0, or omitting it means 'unlimited'."
msgstr "Volitelné I<E<lt>čísloE<gt>> v rozmezí 0-255 může být zadáno jako parametr tohoto příkazu. Číslo udává počet položek verzí podstromu klienta k zobrazení. Zadáním čísla 0 nebo neuvedením žádného čísla, bude použito 'neomezeno'."

#. type: Plain text
#: amulecmd.1.in
msgid "Example: 'statistics 5' will show only the top 5 versions for each client type."
msgstr "Příklad: 'statistics 5' zobrazí jen top 5 verzí u každého typu klienta."

#. type: Plain text
#: amulecmd.1.in
msgid "Show connection status, current up/download speeds, etc."
msgstr "Zobrazit stav připojení, aktuální rychlosti odesílání/stahování atd."

#. type: SS
#: amulecmd.1.in
#, no-wrap
msgid "Languages"
msgstr "Jazyky"

#. type: Plain text
#: amulecmd.1.in
msgid "The I<E<lt>langE<gt>> parameter for the B<-l> option has the following form: I<lang>[B<_>I<LANG>][B<.>I<encoding>][B<@>I<modifier>] where I<lang> is the primary language, I<LANG> is a sublanguage/territory, I<encoding> is the character set to use and I<modifier> allows the user to select a specific instance of localization data within a single category."
msgstr "Parametr I<E<lt>langE<gt>> pro volbu B<-l> má následující formu: I<lang>[B<_>I<LANG>][B<.>I<encoding>][B<@>I<modifier>] kde I<lang> je primární jazyk, I<LANG> je podjazyk/teritorium, I<encoding> je znaková sada, která má být použita a I<modifier> umožňuje uživateli vybrat specifickou instanci lokalizačních dat v rámci jedné kategorie."

#. type: Plain text
#: amulecmd.1.in
msgid "For example, the following strings are valid:"
msgstr "Například, následující řetězce jsou platné:"

#. type: Plain text
#: amulecmd.1.in
msgid "Though all the above strings are accepted as valid language definitions, I<encoding> and I<modifier> are yet unused."
msgstr "I když jsou všechny výše uvedené řetězce přijímány jako platné definice jazyka, I<encoding> a I<modifier> jsou ještě nepoužité."

#. type: Plain text
#: amulecmd.1.in
msgid "In addition to the format above, you can also specify full language names in English - so B<-l german> is also valid and is equal to B<-l de_DE>."
msgstr "Kromě výše uvedeného formátu můžete také zadat názvy jazyků v angličtině - tedy B<-l german> je také platný a odpovídá B<-l de_DE>."

#. type: Plain text
#: amulecmd.1.in
msgid "When no locale is defined, either on command-line or in config file, system default language will be used."
msgstr "Pokud není stanoveno žádné jazykové prostředí, buď na příkazovém řádku nebo v konfiguračním souboru, použije se výchozí jazyk systému."

#. type: Plain text
#: amulecmd.1.in
msgid "~/.aMule/remote.conf"
msgstr "~/.aMule/remote.conf"

#. type: Plain text
#: amulecmd.1.in
msgid "The password is saved as an MD5 digest in [EC]/PasswordMD5, the same key as in amuleapi.conf. An [EC]/Password key from an older file is moved there on load."
msgstr "Heslo je uloženo jako MD5 digest v [EC]/PasswordMD5, stejný klíč jako v amuleapi.conf. [EC]/Password klíč ze staršího souboru je sem přesunut při načtení."

#. type: SH
#: amulecmd.1.in
#, no-wrap
msgid "EXAMPLE"
msgstr "PŘÍKLAD"

#. type: Plain text
#: amulecmd.1.in
msgid "Typically amulecmd will be first run as:"
msgstr "Typicky amulecmd bude prvně spuštěn jako:"

#. type: Plain text
#: amulecmd.1.in
msgid "B<amulecmd> B<-h> I<hostname> B<-p> I<ECport> B<--password-stdin> B<-w>"
msgstr "B<amulecmd> B<-h> I<hostname> B<-p> I<ECport> B<--password-stdin> B<-w>"

#. type: Plain text
#: amulecmd.1.in
msgid "This will save settings to I<$HOME/.aMule/remote.conf>, and later you only need to type:"
msgstr "Toto uloží nastavení do I<$HOME/.aMule/remote.conf> a později bude stačit napsat jen:"

#. type: Plain text
#: amulecmd.1.in
msgid "Of course, you don't have to follow this example."
msgstr "Samozřejmě, nemusíte následovat tento příklad."

#. type: TH
#: amuled.1.in
#, no-wrap
msgid "AMULED"
msgstr "AMULED"

#. type: TH
#: amuled.1.in
#, no-wrap
msgid "aMule Daemon v@PACKAGE_VERSION@"
msgstr "aMule daemon v@PACKAGE_VERSION@"

#. type: TH
#: amuled.1.in
#, no-wrap
msgid "aMule Daemon"
msgstr "aMule daemon"

#. type: Plain text
#: amuled.1.in
msgid "amuled - the all-platform eMule p2p client - daemonized version"
msgstr "amuled - eMule kompatibilní P2P klient pro všechny platformy - daemonized verze"

#. type: Plain text
#: amuled.1.in ../../src/utils/cas/docs/cas.1.in
msgid "[B<-c> I<E<lt>pathE<gt>>]"
msgstr "[B<-c> I<E<lt>cestaE<gt>>]"

#. type: Plain text
#: amuled.1.in
msgid "[B<-p> I<E<lt>pathE<gt>>]"
msgstr "[B<-p> I<E<lt>cestaE<gt>>]"

#. type: Plain text
#: amuled.1.in
msgid "Forks to background."
msgstr "Fork na pozadí."

#. type: TP
#: amuled.1.in
#, no-wrap
msgid "B<[ -p> I<E<lt>pathE<gt>>, B<--pid-file>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ -p> I<E<lt>cestaE<gt>>, B<--pid-file>=I<E<lt>cestaE<gt>> B<]>"

#. type: Plain text
#: amuled.1.in
msgid "After fork, create a pid-file in the I<E<lt>pathE<gt>>.  I<E<lt>pathE<gt>> has to contain the filename."
msgstr "Po forku vytvoří pid-soubor v I<E<lt>cestěE<gt>>.  I<E<lt>cestaE<gt>> musí obsahovat název souboru."

#. type: Plain text
#: amuled.1.in
msgid "Set the External Connections password, enable External Connections, then exit without starting the core. Terminal input is hidden and confirmed; redirected stdin supplies one line without confirmation. An empty password is rejected.  Refused while aMule or another amuled uses the same config dir."
msgstr ""

#. type: Plain text
#: amuled.1.in
msgid "Enable or disable starting amuled on user login, then exit.  The OS-specific store is selected automatically: Windows registry Run key, macOS LaunchAgent, Linux XDG I<.desktop> autostart entry."
msgstr ""

#. type: TP
#: amuled.1.in
#, no-wrap
msgid "B<[ -t> I<E<lt>numE<gt>>, B<--category>=I<E<lt>numE<gt>> B<]>"
msgstr ""

#. type: TP
#: amuled.1.in
#, no-wrap
msgid "I<~/.aMule/allowed-remote-dirs.dat>"
msgstr ""

#. type: Plain text
#: amuled.1.in
msgid "The folders a remote EC or amuleapi client may point the incoming, temporary, shared or category download folders at, one absolute path per line. Empty or absent (the default) means every such remote folder change is refused. On a daemon-only install, such as a container or the Android port with no monolithic aMule to edit the list in its GUI, create or edit this file and restart B<amuled> to allow remote folder changes; relative lines are ignored."
msgstr ""

#. type: SH
#: amuled.1.in
#, no-wrap
msgid "MEDIA METADATA"
msgstr ""

#. type: Plain text
#: amuled.1.in
msgid "B<amuled> runs its bundled B<amule-media-probe> helper on each received file to extract the length, bitrate and codec tags it then publishes to the network. The helper must sit next to the B<amuled> executable. This is on by default (B<Enabled=1> under B<[MediaMetadata]> in I<amule.conf>); set B<Enabled=0> there and restart to turn it off."
msgstr ""

#. type: TH
#: amulegui.1.in
#, no-wrap
msgid "AMULEGUI"
msgstr ""

#. type: TH
#: amulegui.1.in
#, no-wrap
msgid "aMuleGUI v@PACKAGE_VERSION@"
msgstr ""

