#, no-wrap
msgid "NAME"
msgstr "NAAM"

#. type: Plain text
#: amule.1.in
msgid "amule - the all-platform eMule p2p client"
msgstr "amule - de p2p client van eMule voor alle platformen"

#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in amuleweb.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "SYNOPSIS"
msgstr "SYNOPSIS"

#. type: Plain text
#: amule.1.in amulegui.1.in
msgid "[B<-c> I<E<lt>pathE<gt>>] [B<-geometry> I<E<lt>geomE<gt>>]"
msgstr "[B<-c> I<E<lt>padE<gt>>] [B<-geometry> I<E<lt>geomE<gt>>]"

#. type: Plain text
#: amule.1.in amuled.1.in
msgid "[B<-w> I<E<lt>pathE<gt>>]"
msgstr "[B<-w> I<E<lt>padE<gt>>]"

#. type: Plain text
#: amule.1.in amuled.1.in
msgid "[B<-t> I<E<lt>numE<gt>>] [I<eD2k-link>|I<collection-file>]"
msgstr "[B<-t> I<E<lt>numE<gt>>] [I<eD2k-koppeling>|I<collectie-bestand>]"

#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in amuleweb.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "DESCRIPTION"
msgstr "BESCHRIJVING"

#. type: TP
#: amule.1.in amuled.1.in amulegui.1.in ed2k.1.in
#: ../../src/utils/cas/docs/cas.1.in
#, no-wrap
msgid "B<[ -c> I<E<lt>pathE<gt>>, B<--config-dir>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ -c> I<E<lt>padE<gt>>, B<--config-dir>=I<E<lt>padE<gt>> B<]>"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in ed2k.1.in
#: ../../src/utils/cas/docs/cas.1.in
msgid "Read config from I<E<lt>pathE<gt>> instead of home"
msgstr "Lees configuratiebestand vanuit I<E<lt>padE<gt>> in plaats van de thuislocatie"

#. type: TP
#: amule.1.in amulegui.1.in
#, no-wrap
msgid "B<[ -geometry >I<E<lt>geomE<gt>> B<]>"
msgstr "B<[ -geometry>I<E<lt>geomE<gt>> B<]>"

#. type: Plain text
#: amule.1.in amulegui.1.in
msgid "Sets the geometry of the app. I<E<lt>geomE<gt>> uses the same format as standard X11 apps:\t[B<=>][I<E<lt>widthE<gt>>{B<xX>}I<E<lt>heightE<gt>>][{B<+->}I<E<lt>xoffsetE<gt>>{B<+->}I<E<lt>yoffsetE<gt>>]"
msgstr "Stelt de geometrie van de app in. I<E<lt>geomE<gt>> gebruikt hetzelfde format als standaard X11 apps:\t[B<=>][I<E<lt>breedteE<gt>>{B<xX>}I<E<lt>hoogteE<gt>>][{B<+->}I<E<lt>xoffsetE<gt>>{B<+->}I<E<lt>yoffsetE<gt>>]"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Prints log messages to stdout."
msgstr "Print logberichten naar stdout."

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Resets config to default values."
msgstr "Herstelt configuratiebestand naar standaardwaarden."

#. type: Plain text
#: amule.1.in
msgid "Enable or disable starting aMule on user login, then exit.  The OS-specific store is selected automatically: Windows registry Run key, macOS LaunchAgent, Linux XDG I<.desktop> autostart entry."
msgstr "Schakel het starten van aMule bij het aanmelden van de gebruiker in of uit, sluit dan af.  De OS-specifieke appstore wordt automatisch geselecteerd: Windows registry Run sleutel, macOS LaunchAgent, Linux XDG I<.desktop> autostart item."

#. type: TP
#: amule.1.in amuled.1.in
#, no-wrap
msgid "B<[ -w> I<E<lt>pathE<gt>>, B<--use-amuleweb>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ -w> I<E<lt>padE<gt>>, B<--use-amuleweb>=I<E<lt>padE<gt>> B<]>"

#. type: Plain text
#: amule.1.in amuled.1.in
msgid "Specify location of amuleweb binary to I<E<lt>pathE<gt>>."
msgstr "Specificeer locatie van het amuleweb binaire bestand naar I<E<lt>padE<gt>>."

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Don't catch fatal exceptions and don't block exit on assertions.  Useful for headless / supervised setups (systemd, watchdog scripts)  where the otherwise-modal assertion dialog prevents auto-restart."
msgstr "Vang fatale uitzonderingen niet op en blokkeer afsluiten bij constatering niet.  Handig voor headless / begeleide configuraties (systemd, watchdog scripts)  waar het anders-modale constateringsdialoogvenster automatisch opnieuw opstarten voorkomt."

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Does not disable stdin."
msgstr "Schakelt stdin niet uit."

#. type: TP
#: amule.1.in amulegui.1.in
#, no-wrap
msgid "B<[ -t>, B<--category>=I<E<lt>numE<gt>> B<]>"
msgstr "B<[ -t>, B<--category>=I<E<lt>numE<gt>> B<]>"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Set category for passed eD2k links to I<E<lt>numE<gt>>"
msgstr "Stelt categorie voor geslaagde eD2k koppelingen in als I<E<lt>numE<gt>>"

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in amuleweb.1.in ed2k.1.in
msgid "Displays the current version number."
msgstr "Toont het huidige versienummer."

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in amuleweb.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in
msgid "Prints a short usage description."
msgstr "Print een korte gebruiksbeschrijving."

#. type: TP
#: amule.1.in amuled.1.in
#, no-wrap
msgid "B<[ eD2k-link | collection-file ]>"
msgstr "B<[ eD2k-koppeling | collectie-bestand ]>"

#. type: Plain text
#: amule.1.in amuled.1.in
msgid "Adds an eD2k-link, or every link in an eMule collection file, to the core."
msgstr "Voegt een eD2k-koppeling, of elke koppeling in een eMule collectiebestand, toe aan de kern."

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in ed2k.1.in
msgid "The eD2k link to be added can be:"
msgstr "De eD2k-koppeling die toegevoegd gaat worden kan zijn:"

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in ed2k.1.in
msgid "a file link (ed2k://|file|...), it will be added to the download queue;"
msgstr "een bestandskoppeling (ed2k://|file|...), het zal worden toegevoegd aan de downloadwachtrij;"

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in ed2k.1.in
msgid "a server link (ed2k://|server|...), it will be added to the server list;"
msgstr "een serverkoppeling (ed2k://|server|...), het zal worden toegevoegd aan de serverlijst;"

#. type: Plain text
#: amule.1.in amuled.1.in ed2k.1.in
msgid "a serverlist link, in which case all servers in the list will be added to the server list;"
msgstr "een serverlijst-koppeling, in welk geval alle servers in de lijst zullen worden toegevoegd aan de serverlijst;"

#. type: Plain text
#: amule.1.in amuled.1.in
msgid "a magnet link."
msgstr "een magnet-koppeling."

#. type: Plain text
#: amule.1.in amuled.1.in
msgid "Alternatively the argument can be the path to an .emulecollection file, or a file:// URL naming one, in which case every link it contains is added to the download queue.  This is what lets a file manager open a collection with aMule."
msgstr "Alternatief kan het argument het pad naar een .emulecollection bestand zijn, of een bestand met een:// URL naam, in welk geval elke koppeling die erin staat wordt toegevoegd aan de downloadwachtrij.  Dit is wat bestandsbeheer een collectie met aMule laat openen."

#. type: SH
#: amule.1.in amulecmd.1.in amuleweb.1.in
#, no-wrap
msgid "NOTES"
msgstr "NOTITIES"

#. type: SS
#: amule.1.in amulecmd.1.in amuleweb.1.in
#, no-wrap
msgid "Paths"
msgstr "Paden"

#. type: Plain text
#: amule.1.in amulecmd.1.in amuleweb.1.in
msgid "For all options which take a I<E<lt>pathE<gt>> value, if the I<path> contains no directory part (i.e. just a plain filename), then it is considered to be under the aMule configuration directory, I<~/.aMule>."
msgstr "Voor alle opties die een I<E<lt>padE<gt>> waarde aannemen, als het I<pad> geen map-deel bevat (b.v.b. een simpele bestandsnaam), dan wordt het aangenomen dat het onder de aMule-configuratiemap valt, I<~/.aMule>."

#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amuleweb.1.in ed2k.1.in
#: ../../src/utils/cas/docs/cas.1.in
#, no-wrap
msgid "FILES"
msgstr "BESTANDEN"

#. type: Plain text
#: amule.1.in amuled.1.in
msgid "~/.aMule/*"
msgstr "~/.aMule/*"

#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in amuleweb.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "REPORTING BUGS"
msgstr "RAPPORTEER FOUTEN"

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in amuleweb.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
msgid "Please report bugs either on our forum (I<https://github.com/amule-org/amule/discussions>), or in our bugtracker (I<https://github.com/amule-org/amule/issues>).  Please do not report bugs in e-mail, neither to our mailing list nor directly to any team member."
msgstr "Rapporteer fouten op ons forum (I<https://github.com/amule-org/amule/discussions>), of in onze foutenvolger (I<https://github.com/amule-org/amule/issues>).  Rapporteer alstublieft geen fouten per e-mail, niet naar onze mailinglijst en niet naar een individueel teamlid."

#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in amuleweb.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
