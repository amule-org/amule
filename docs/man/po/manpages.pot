#. type: Plain text
#: amulecmd.1.in
msgid "Show log."
msgstr ""

#. type: Plain text
#: amulecmd.1.in
msgid "Show servers list."
msgstr ""

#. type: Plain text
#: amulecmd.1.in
msgid "Show shared files list."
