#, no-wrap
msgid "NAME"
msgstr "NOM"

#. type: Plain text
#: amule.1.in
msgid "amule - the all-platform eMule p2p client"
msgstr "amule - el client p2p d'eMule multiplataforma"

#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in amuleweb.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "SYNOPSIS"
msgstr "SINOPSI"

#. type: Plain text
#: amule.1.in amulegui.1.in
msgid "[B<-c> I<E<lt>pathE<gt>>] [B<-geometry> I<E<lt>geomE<gt>>]"
msgstr "[B<-c> I<E<lt>pathE<gt>>] [B<-geometry> I<E<lt>geomE<gt>>]"

#. type: Plain text
#: amule.1.in amuled.1.in
msgid "[B<-w> I<E<lt>pathE<gt>>]"
msgstr "[B<-w> I<E<lt>pathE<gt>>]"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "[B<-t> I<E<lt>numE<gt>>] [I<eD2k-link>|I<collection-file>]"
msgstr "[B<-t> I<E<lt>numE<gt>>] [I<eD2k-link>|I<collection-file>]"

#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in amuleweb.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "DESCRIPTION"
msgstr "DESCRIPCIÓ"

#. type: TP
#: amule.1.in amuled.1.in amulegui.1.in ed2k.1.in
#: ../../src/utils/cas/docs/cas.1.in
#, no-wrap
msgid "B<[ -c> I<E<lt>pathE<gt>>, B<--config-dir>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ -c> I<E<lt>pathE<gt>>, B<--config-dir>=I<E<lt>pathE<gt>> B<]>"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in ed2k.1.in
#: ../../src/utils/cas/docs/cas.1.in
msgid "Read config from I<E<lt>pathE<gt>> instead of home"
msgstr "Llegeix la configuració de I<E<lt>pathE<gt>> en lloc del directori d'usuari"

#. type: TP
#: amule.1.in amulegui.1.in
#, no-wrap
msgid "B<[ -geometry >I<E<lt>geomE<gt>> B<]>"
msgstr "B<[ -geometry >I<E<lt>geomE<gt>> B<]>"

#. type: Plain text
#: amule.1.in amulegui.1.in
msgid "Sets the geometry of the app. I<E<lt>geomE<gt>> uses the same format as standard X11 apps:\t[B<=>][I<E<lt>widthE<gt>>{B<xX>}I<E<lt>heightE<gt>>][{B<+->}I<E<lt>xoffsetE<gt>>{B<+->}I<E<lt>yoffsetE<gt>>]"
msgstr "Estableix la geometria de l'aplicació. I<E<lt>geomE<gt>> fa servir el mateix format que les aplicacions X11 estàndard:\t[B<=>][I<E<lt>widthE<gt>>{B<xX>}I<E<lt>heightE<gt>>][{B<+->}I<E<lt>xoffsetE<gt>>{B<+->}I<E<lt>yoffsetE<gt>>]"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Prints log messages to stdout."
msgstr "Escriu els missatges de registre a stdout."

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Resets config to default values."
msgstr "Restableix la configuració als valors predeterminats."

#. type: Plain text
#: amule.1.in
msgid "Enable or disable starting aMule on user login, then exit.  The OS-specific store is selected automatically: Windows registry Run key, macOS LaunchAgent, Linux XDG I<.desktop> autostart entry."
msgstr "Habilita o inhabilita l'inici de l'aMule en iniciar la sessió i surt.  El magatzem específic del sistema operatiu se selecciona automàticament: clau Run del registre de Windows, LaunchAgent de macOS, entrada d'inici automàtic XDG I<.desktop> de Linux."

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Enable or disable aMule as the current user's default handler for ed2k:// and magnet: links, then exit.  I<E<lt>valueE<gt>> is B<on> or B<off> for both kinds of link, or B<ed2k:on>, B<ed2k:off>, B<magnet:on> or B<magnet:off> for one of them.  The OS-specific store is selected automatically: Windows registry, macOS LaunchServices, Linux XDG I<mimeapps.list>."
msgstr "Habilita o inhabilita l'aMule com a gestor predeterminat de l'usuari actual per als enllaços ed2k:// i magnet: i surt.  I<E<lt>valueE<gt>> és B<on> o B<off> per als dos tipus d'enllaç, o B<ed2k:on>, B<ed2k:off>, B<magnet:on> o B<magnet:off> per a només un d'ells.  El magatzem específic del sistema operatiu se selecciona automàticament: registre de Windows, LaunchServices de macOS, I<mimeapps.list> XDG de Linux."

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Enable or disable aMule as the current user's handler for I<.emulecollection> files, then exit.  The OS-specific store is selected automatically: Windows registry, macOS LaunchServices, Linux XDG I<mimeapps.list>."
msgstr "Habilita o inhabilita l'aMule com a gestor dels fitxers I<.emulecollection> de l'usuari actual i surt.  El magatzem específic del sistema operatiu se selecciona automàticament: registre de Windows, LaunchServices de macOS, I<mimeapps.list> XDG de Linux."

#. type: TP
#: amule.1.in amuled.1.in
#, no-wrap
msgid "B<[ -w> I<E<lt>pathE<gt>>, B<--use-amuleweb>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ -w> I<E<lt>pathE<gt>>, B<--use-amuleweb>=I<E<lt>pathE<gt>> B<]>"

#. type: Plain text
#: amule.1.in amuled.1.in
msgid "Specify location of amuleweb binary to I<E<lt>pathE<gt>>."
msgstr "Especifica la ubicació del binari amuleweb a I<E<lt>pathE<gt>>."

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Don't catch fatal exceptions and don't block exit on assertions.  Useful for headless / supervised setups (systemd, watchdog scripts)  where the otherwise-modal assertion dialog prevents auto-restart."
msgstr "No capturis les excepcions fatals ni bloquegis la sortida en les assercions.  Útil per a configuracions sense interfície o supervisades (systemd, scripts de vigilància)  on el diàleg d'asserció, que altrament és modal, impedeix el reinici automàtic."

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Does not disable stdin."
msgstr "No desactiva stdin."

#. type: TP
#: amule.1.in amulegui.1.in
#, no-wrap
msgid "B<[ -t>, B<--category>=I<E<lt>numE<gt>> B<]>"
msgstr "B<[ -t>, B<--category>=I<E<lt>numE<gt>> B<]>"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Set category for passed eD2k links to I<E<lt>numE<gt>>"
msgstr "Estableix la categoria dels enllaços eD2k passats a I<E<lt>numE<gt>>"

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in amuleweb.1.in ed2k.1.in
msgid "Displays the current version number."
msgstr "Mostra el número de versió actual."

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in amuleweb.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in
msgid "Prints a short usage description."
msgstr "Mostra una breu descripció d'ús."

#. type: TP
#: amule.1.in amuled.1.in amulegui.1.in
#, no-wrap
msgid "B<[ eD2k-link | collection-file ]>"
msgstr "B<[ eD2k-link | collection-file ]>"

#. type: Plain text
#: amule.1.in amuled.1.in
msgid "Adds an eD2k-link, or every link in an eMule collection file, to the core."
msgstr "Afegeix un enllaç eD2k, o tots els enllaços d'un fitxer de col·lecció d'eMule, al nucli."

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in ed2k.1.in
msgid "The eD2k link to be added can be:"
msgstr "L'enllaç eD2k que s'afegeix pot ser:"

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in ed2k.1.in
msgid "a file link (ed2k://|file|...), it will be added to the download queue;"
msgstr "un enllaç de fitxer (ed2k://|file|...), que s'afegirà a la cua de baixades;"

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in ed2k.1.in
msgid "a server link (ed2k://|server|...), it will be added to the server list;"
msgstr "un enllaç de servidor (ed2k://|server|...), que s'afegirà a la llista de servidors;"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in ed2k.1.in
msgid "a serverlist link, in which case all servers in the list will be added to the server list;"
msgstr "un enllaç de llista de servidors, cas en què tots els servidors de la llista s'afegiran a la llista de servidors;"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "a magnet link."
msgstr "un enllaç magnet."

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Alternatively the argument can be the path to an .emulecollection file, or a file:// URL naming one, in which case every link it contains is added to the download queue.  This is what lets a file manager open a collection with aMule."
msgstr "Alternativament, l'argument pot ser la ruta a un fitxer .emulecollection, o un URL file:// que n'indiqui un, i en aquest cas tots els enllaços que contingui s'afegeixen a la cua de baixades.  Això és el que permet que un gestor de fitxers obri una col·lecció amb l'aMule."

#. type: SH
#: amule.1.in amulecmd.1.in amulegui.1.in amuleweb.1.in
#, no-wrap
msgid "NOTES"
msgstr "NOTES"

#. type: SS
#: amule.1.in amulecmd.1.in amulegui.1.in amuleweb.1.in
#, no-wrap
msgid "Paths"
msgstr "Camins"

#. type: Plain text
#: amule.1.in amulecmd.1.in amulegui.1.in amuleweb.1.in
msgid "For all options which take a I<E<lt>pathE<gt>> value, if the I<path> contains no directory part (i.e. just a plain filename), then it is considered to be under the aMule configuration directory, I<~/.aMule>."
msgstr "Per a totes les opcions que accepten un valor I<E<lt>pathE<gt>>, si el I<camí> no conté cap part de directori (és a dir, només un nom de fitxer), es considera que és dins del directori de configuració de l'aMule, I<~/.aMule>."

#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in amuleweb.1.in ed2k.1.in
#: ../../src/utils/cas/docs/cas.1.in
#, no-wrap
msgid "FILES"
msgstr "FITXERS"

#. type: Plain text
#: amule.1.in amuled.1.in
msgid "~/.aMule/*"
msgstr "~/.aMule/*"

#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in amuleweb.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "REPORTING BUGS"
msgstr "COM INFORMAR D'ERRORS"

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in amuleweb.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
msgid "Please report bugs either on our forum (I<https://github.com/amule-org/amule/discussions>), or in our bugtracker (I<https://github.com/amule-org/amule/issues>).  Please do not report bugs in e-mail, neither to our mailing list nor directly to any team member."
msgstr "Informeu dels errors al nostre fòrum (I<https://github.com/amule-org/amule/discussions>) o al nostre sistema de seguiment d'errors (I<https://github.com/amule-org/amule/issues>).  No informeu dels errors per correu electrònic, ni a la nostra llista de correu ni directament a cap membre de l'equip."

#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in amuleweb.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
