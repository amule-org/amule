#. type: TH
#: amulecmd.1.in
#, no-wrap
msgid "AMULECMD"
msgstr "AMULECMD"

#. type: TH
#: amulecmd.1.in
#, no-wrap
msgid "aMuleCmd v@PACKAGE_VERSION@"
msgstr "aMuleCmd v@PACKAGE_VERSION@"

#. type: TH
#: amulecmd.1.in amuleweb.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "aMule utilities"
msgstr "Utilitats de l'aMule"

#. type: Plain text
#: amulecmd.1.in
msgid "amulecmd - Console-based program to control aMule"
msgstr "amulecmd - programa de consola per controlar l'aMule"

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "[B<-h> I<E<lt>hostE<gt>>] [B<-p> I<E<lt>portE<gt>>] [B<-P> I<E<lt>passwordE<gt>>] [B<-f> I<E<lt>pathE<gt>>]"
msgstr "[B<-h> I<E<lt>hostE<gt>>] [B<-p> I<E<lt>portE<gt>>] [B<-P> I<E<lt>passwordE<gt>>] [B<-f> I<E<lt>pathE<gt>>]"

#. type: Plain text
#: amulecmd.1.in
msgid "[B<-l> I<E<lt>langE<gt>>] {B< >[B<-w>]B< >|B< >[B<-c> I<E<lt>commandE<gt>>]B< >}"
msgstr "[B<-l> I<E<lt>langE<gt>>] {B< >[B<-w>]B< >|B< >[B<-c> I<E<lt>commandE<gt>>]B< >}"

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "[B<--create-config-from>=I<E<lt>pathE<gt>>]"
msgstr "[B<--create-config-from>=I<E<lt>pathE<gt>>]"

#. type: Plain text
#: amulecmd.1.in
msgid "B<amulecmd> is a console-based client to control aMule."
msgstr "B<amulecmd> és un client de consola per controlar l'aMule."

#. type: TP
#: amulecmd.1.in amuleweb.1.in
#, no-wrap
msgid "B<[ -h> I<E<lt>hostE<gt>>, B<--host>=I<E<lt>hostE<gt>> B<]>"
msgstr "B<[ -h> I<E<lt>hostE<gt>>, B<--host>=I<E<lt>hostE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "Host where aMule is running (default: I<127.0.0.1>).  I<E<lt>hostE<gt>> might be an IP address or a DNS name"
msgstr "Amfitrió on s'executa l'aMule (predeterminat: I<127.0.0.1>).  I<E<lt>hostE<gt>> pot ser una adreça IP o un nom DNS"

#. type: TP
#: amulecmd.1.in amuleweb.1.in
#, no-wrap
msgid "B<[ -p> I<E<lt>portE<gt>>, B<--port>=I<E<lt>portE<gt>> B<]>"
msgstr "B<[ -p> I<E<lt>portE<gt>>, B<--port>=I<E<lt>portE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "aMule's port for External Connections, as set in Preferences-E<gt>Remote Controls (default: I<4712>)"
msgstr "Port de l'aMule per a connexions externes, tal com s'ha definit a Preferències-E<gt>Controls remots (predeterminat: I<4712>)"

#. type: TP
#: amulecmd.1.in amuleweb.1.in
#, no-wrap
msgid "B<[ -P> I<E<lt>passwordE<gt>>, B<--password>=I<E<lt>passwordE<gt>> B<]>"
msgstr "B<[ -P> I<E<lt>passwordE<gt>>, B<--password>=I<E<lt>passwordE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "External Connections password."
msgstr "Contrasenya de les connexions externes."

#. type: TP
#: amulecmd.1.in amuleweb.1.in
#, no-wrap
msgid "B<[ -f> I<E<lt>pathE<gt>>, B<--config-file>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ -f> I<E<lt>pathE<gt>>, B<--config-file>=I<E<lt>pathE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "Use the given configuration file.  Default configuration file is I<~/.aMule/remote.conf>"
msgstr "Fa servir el fitxer de configuració indicat.  El fitxer de configuració predeterminat és I<~/.aMule/remote.conf>"

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "Do not print any output to stdout."
msgstr "No escriguis cap sortida a stdout."

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "Be verbose - show also debug messages."
msgstr "Mode detallat: mostra també els missatges de depuració."

#. type: TP
#: amulecmd.1.in amuleweb.1.in
#, no-wrap
msgid "B<[ -l> I<E<lt>langE<gt>>, B<--locale>=I<E<lt>langE<gt>> B<]>"
msgstr "B<[ -l> I<E<lt>langE<gt>>, B<--locale>=I<E<lt>langE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "Sets program locale (language).  See the B<NOTES> section for the description of the I<E<lt>langE<gt>> parameter."
msgstr "Estableix la configuració regional (idioma) del programa.  Consulteu la secció B<NOTES> per a la descripció del paràmetre I<E<lt>langE<gt>>."

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "Write command line options to config file and exit"
msgstr "Escriu les opcions de la línia d'ordres al fitxer de configuració i surt"

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<[ -c> I<E<lt>commandE<gt>>, B<--command>=I<E<lt>commandE<gt>> B<]>"
msgstr "B<[ -c> I<E<lt>commandE<gt>>, B<--command>=I<E<lt>commandE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in
msgid "Execute I<E<lt>commandE<gt>> as if it was entered at amulecmd's prompt and exit."
msgstr "Executa I<E<lt>commandE<gt>> com si s'hagués escrit a l'indicador d'amulecmd i surt."

#. type: TP
#: amulecmd.1.in amuleweb.1.in
#, no-wrap
msgid "B<[ --create-config-from>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ --create-config-from>=I<E<lt>pathE<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "Create config file based upon I<E<lt>pathE<gt>>, which must point to a valid aMule config file, and then exit."
msgstr "Crea un fitxer de configuració basat en I<E<lt>pathE<gt>>, que ha d'apuntar a un fitxer de configuració vàlid de l'aMule, i després surt."

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "Do not encrypt the External Connection link.  Encryption is negotiated automatically whenever the remote aMule supports it, and is on by default for every destination, local or remote.  Turning it off leaves everything after the login readable, and modifiable, by anyone able to observe the connection."
msgstr "No xifris l'enllaç de connexió externa.  El xifratge es negocia automàticament sempre que l'aMule remot l'admet, i està activat per defecte per a totes les destinacions, locals o remotes.  Si es desactiva, tot el que ve després de l'inici de sessió pot ser llegit, i modificat, per qualsevol que pugui observar la connexió."

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "Force ZLIB compression on the External Connection link regardless of the dialed-IP locality.  Useful when the server side is reachable over a VPN tunnel that resolves to a LAN IP and the heuristic would otherwise skip compression."
msgstr "Força la compressió ZLIB a l'enllaç de connexió externa independentment de si la IP marcada és local.  Útil quan el costat del servidor és accessible per un túnel VPN que resol a una IP de la LAN i l'heurística ometria la compressió."

#. type: Plain text
#: amulecmd.1.in
msgid "Separate the fields of the list commands with spaces, as earlier versions did, instead of tabs.  Client names and file names may contain spaces, so the default tab separator is what lets a script split a row back into its fields; use this only for scripts written against the older output."
msgstr "Separa els camps de les ordres de llista amb espais, com feien les versions anteriors, en lloc de tabulacions.  Els noms de client i de fitxer poden contenir espais, de manera que el separador de tabulació predeterminat és el que permet que un script torni a dividir una fila en els seus camps; feu-ho servir només per a scripts escrits per a la sortida antiga."

#. type: SH
#: amulecmd.1.in
#, no-wrap
msgid "COMMANDS"
msgstr "ORDRES"

#. type: Plain text
#: amulecmd.1.in
msgid "All commands are case insensitive."
msgstr "Totes les ordres són insensibles a majúscules i minúscules."

#. type: Plain text
#: amulecmd.1.in
msgid "Adds an eD2k-link or a magnet-link to the core."
msgstr "Afegeix un enllaç eD2k o un enllaç magnet al nucli."

#. type: Plain text
#: amulecmd.1.in
msgid "a serverlist link, in which case all servers in the list will be added to the server list."
msgstr "un enllaç de llista de servidors, cas en què tots els servidors de la llista s'afegiran a la llista de servidors."

#. type: Plain text
#: amulecmd.1.in
msgid "The magnet link must contain the eD2k hash and file length."
msgstr "L'enllaç magnet ha de contenir el hash eD2k i la mida del fitxer."

#. type: Plain text
#: amulecmd.1.in
msgid "Cancels the download specified by I<E<lt>hashE<gt>> or I<E<lt>numberE<gt>>. To get the value use B<show>."
msgstr "Cancel·la la baixada especificada per I<E<lt>hashE<gt>> o I<E<lt>numberE<gt>>. Per obtenir-ne el valor, feu servir B<show>."

#. type: Plain text
#: amulecmd.1.in
msgid "Connect to the network."
msgstr "Connecta a la xarxa."

#. type: Plain text
#: amulecmd.1.in
msgid "This will connect to all networks that are enabled in Preferences."
msgstr "Això connectarà a totes les xarxes habilitades a les preferències."

#. type: Plain text
#: amulecmd.1.in
msgid "With the optional parameter you can specify which network to connect to. Giving a server address in the form of IP:Port (where IP is either a dotted decimal IPv4 address or a resolvable DNS name) aMule will connect to that server only."
msgstr "Amb el paràmetre opcional podeu especificar a quina xarxa voleu connectar. Si indiqueu una adreça de servidor en format IP:Port (on IP és una adreça IPv4 decimal amb punts o un nom DNS resoluble), l'aMule connectarà només a aquest servidor."

#. type: Plain text
#: amulecmd.1.in
msgid "Disconnect from all networks you are connected to, or just disconnect from the specified network."
msgstr "Desconnecta de totes les xarxes a les quals esteu connectat, o desconnecta només de la xarxa especificada."

#. type: Plain text
#: amulecmd.1.in
msgid "Start downloading a file."
msgstr "Comença a baixar un fitxer."

#. type: Plain text
#: amulecmd.1.in
msgid "Give the I<E<lt>numberE<gt>> of a file as listed by B<results>, optionally followed by a search I<E<lt>idE<gt>> (as printed by B<search>). Without an id, the number refers to the last B<results> output, or to the most recently started search if nothing was listed yet.  Example: 'download 12' downloads file 12 of the last results; 'download 12 3' downloads file 12 of search 3."
msgstr "Indiqueu el I<E<lt>numberE<gt>> d'un fitxer tal com el llista B<results>, seguit opcionalment d'un I<E<lt>idE<gt>> de cerca (tal com l'escriu B<search>). Sense id, el número fa referència a l'última sortida de B<results>, o a la cerca iniciada més recentment si encara no s'ha llistat res.  Exemple: 'download 12' baixa el fitxer 12 dels últims resultats; 'download 12 3' baixa el fitxer 12 de la cerca 3."

#. type: Plain text
#: amulecmd.1.in
msgid "Disconnect from amule/amuled and quit amulecmd."
msgstr "Desconnecta d'amule/amuled i surt d'amulecmd."

#. type: Plain text
#: amulecmd.1.in
msgid "Get and display a preference value."
msgstr "Obtén i mostra el valor d'una preferència."

#. type: Plain text
#: amulecmd.1.in
msgid "Available values for I<E<lt>whatE<gt>>:"
msgstr "Valors disponibles per a I<E<lt>whatE<gt>>:"

#. type: Plain text
#: amulecmd.1.in
msgid "Get bandwidth limits."
msgstr "Obtén els límits d'amplada de banda."

#. type: Plain text
#: amulecmd.1.in
msgid "Get IPFilter preferences."
msgstr "Obtén les preferències de l'IPFilter."

#. type: Plain text
#: amulecmd.1.in
msgid "Prints a short usage description.  If called without parameter, it shows a list of available commands.  If called with I<E<lt>commandE<gt>>, it shows a short description of the given command."
msgstr "Mostra una breu descripció d'ús.  Si es crida sense paràmetres, mostra una llista de les ordres disponibles.  Si es crida amb I<E<lt>commandE<gt>>, mostra una breu descripció de l'ordre indicada."

#. type: Plain text
#: amulecmd.1.in
msgid "Pauses the download specified by I<E<lt>hashE<gt>> or I<E<lt>numberE<gt>>. To get the value use B<show>."
msgstr "Posa en pausa la baixada especificada per I<E<lt>hashE<gt>> o I<E<lt>numberE<gt>>. Per obtenir-ne el valor, feu servir B<show>."

#. type: Plain text
#: amulecmd.1.in
msgid "Set priority of a download specified by I<E<lt>hashE<gt>> or I<E<lt>numberE<gt>>."
msgstr "Estableix la prioritat d'una baixada especificada per I<E<lt>hashE<gt>> o I<E<lt>numberE<gt>>."

#. type: Plain text
#: amulecmd.1.in
msgid "Available values for I<E<lt>priorityE<gt>>:"
msgstr "Valors disponibles per a I<E<lt>priorityE<gt>>:"

#. type: Plain text
#: amulecmd.1.in
msgid "Automatic priority."
msgstr "Prioritat automàtica."

#. type: Plain text
#: amulecmd.1.in
msgid "High priority."
msgstr "Prioritat alta."

#. type: Plain text
#: amulecmd.1.in
msgid "Low priority."
msgstr "Prioritat baixa."

#. type: Plain text
#: amulecmd.1.in
msgid "Normal priority."
msgstr "Prioritat normal."

#. type: Plain text
#: amulecmd.1.in
msgid "Shows the progress of an on-going search. Optionally takes a search I<E<lt>idE<gt>> (as printed by B<search>); with no id, shows the most recently started search."
msgstr "Mostra el progrés d'una cerca en curs. Opcionalment accepta un I<E<lt>idE<gt>> de cerca (tal com l'escriu B<search>); sense id, mostra la cerca iniciada més recentment."

#. type: Plain text
#: amulecmd.1.in
msgid "A synonym of the B<exit> command."
msgstr "Sinònim de l'ordre B<exit>."

#. type: Plain text
#: amulecmd.1.in
msgid "Reloads a given object."
msgstr "Torna a carregar un objecte determinat."

#. type: Plain text
#: amulecmd.1.in
msgid "Reload shared files list."
msgstr "Torna a carregar la llista de fitxers compartits."

#. type: Plain text
#: amulecmd.1.in
msgid "Reload IP filter tables."
msgstr "Torna a carregar les taules del filtre d'IP."

#. type: Plain text
#: amulecmd.1.in
msgid "Reset the log."
msgstr "Reinicia el registre."

#. type: Plain text
#: amulecmd.1.in
msgid "Shows you the results of a search. Optionally takes a search I<E<lt>idE<gt>> (as printed by B<search>); with no id, shows the most recently started search.  Several searches can be kept on the daemon at once and addressed by id."
msgstr "Mostra els resultats d'una cerca. Opcionalment accepta un I<E<lt>idE<gt>> de cerca (tal com l'escriu B<search>); sense id, mostra la cerca iniciada més recentment.  El dimoni pot mantenir diverses cerques alhora, a les quals es fa referència per id."

#. type: Plain text
#: amulecmd.1.in
msgid "Resumes the download specified by I<E<lt>hashE<gt>> or I<E<lt>numberE<gt>>. To get the value use B<show>."
msgstr "Reprèn la baixada especificada per I<E<lt>hashE<gt>> o I<E<lt>numberE<gt>>. Per obtenir-ne el valor, feu servir B<show>."

#. type: Plain text
#: amulecmd.1.in
msgid "Makes a search for the given I<E<lt>keywordE<gt>>. A search type and a keyword to search is mandatory to do this.  Example: 'search kad amule' performs a kad search for 'amule'.  Prints a search id; pass it to B<results> or B<progress> to address this search. Several searches can run at once, each with its own id."
msgstr "Fa una cerca de la I<E<lt>keywordE<gt>> indicada. Per fer-ho, cal indicar un tipus de cerca i una paraula clau.  Exemple: 'search kad amule' fa una cerca kad de 'amule'.  Escriu un id de cerca; passeu-lo a B<results> o B<progress> per referir-vos a aquesta cerca. Es poden executar diverses cerques alhora, cadascuna amb el seu propi id."

#. type: Plain text
#: amulecmd.1.in
msgid "Available search types:"
msgstr "Tipus de cerca disponibles:"

#. type: Plain text
#: amulecmd.1.in
msgid "Performs a global search."
msgstr "Fa una cerca global."

#. type: Plain text
#: amulecmd.1.in
msgid "Performs a search on the Kademlia network."
msgstr "Fa una cerca a la xarxa Kademlia."

#. type: Plain text
#: amulecmd.1.in
msgid "Performs a local search."
msgstr "Fa una cerca local."

#. type: Plain text
#: amulecmd.1.in
msgid "Optional filters can be placed before, after, or interleaved with the search keyword(s):"
msgstr "Es poden col·locar filtres opcionals abans, després o intercalats amb les paraules de cerca:"

#. type: Plain text
#: amulecmd.1.in
msgid "Restrict results to the given file type."
msgstr "Restringeix els resultats al tipus de fitxer indicat."

#. type: Plain text
#: amulecmd.1.in
msgid "Restrict results to a specific file extension (e.g.\\ I<iso>, I<mp3>)."
msgstr "Restringeix els resultats a una extensió de fitxer concreta (p. ex.\\ I<iso>, I<mp3>)."

#. type: Plain text
#: amulecmd.1.in
msgid "Minimum number of sources a result must report."
msgstr "Nombre mínim de fonts que ha d'informar un resultat."

#. type: Plain text
#: amulecmd.1.in
msgid "Smallest file size to return. Suffixes use binary multipliers (K = 1024, M = K\\(mu1024, G = M\\(mu1024); no suffix means bytes."
msgstr "Mida de fitxer mínima que es retorna. Els sufixos fan servir multiplicadors binaris (K = 1024, M = K\\(mu1024, G = M\\(mu1024); sense sufix vol dir bytes."

#. type: Plain text
#: amulecmd.1.in
msgid "Largest file size to return. Same suffixes as B<--min-size>."
msgstr "Mida de fitxer màxima que es retorna. Mateixos sufixos que B<--min-size>."

#. type: Plain text
#: amulecmd.1.in
msgid "Example: 'search global linux iso --type Iso --min-size 100M' returns results for 'linux iso' of file-type Iso at least 100 MiB."
msgstr "Exemple: 'search global linux iso --type Iso --min-size 100M' retorna resultats de 'linux iso' del tipus de fitxer Iso de com a mínim 100 MiB."

#. type: Plain text
#: amulecmd.1.in
msgid "Sets a given preferences value."
msgstr "Estableix el valor d'una preferència."

#. type: Plain text
#: amulecmd.1.in
msgid "Set bandwidth limits."
msgstr "Estableix els límits d'amplada de banda."

#. type: Plain text
#: amulecmd.1.in
msgid "Set IPFilter preferences."
msgstr "Estableix les preferències de l'IPFilter."

#. type: Plain text
#: amulecmd.1.in
msgid "Shows upload/download queue, servers list or shared files list."
msgstr "Mostra la cua de pujada/baixada, la llista de servidors o la llista de fitxers compartits."

#. type: Plain text
#: amulecmd.1.in
msgid "Show download queue."
msgstr "Mostra la cua de baixades."

#. type: Plain text
#: amulecmd.1.in
msgid "Show log."
msgstr "Mostra el registre."

#. type: Plain text
#: amulecmd.1.in
msgid "Show servers list."
msgstr "Mostra la llista de servidors."

#. type: Plain text
#: amulecmd.1.in
msgid "Show shared files list."
msgstr "Mostra la llista de fitxers compartits."

#. type: Plain text
#: amulecmd.1.in
msgid "Show upload queue."
msgstr "Mostra la cua de pujades."

#. type: Plain text
#: amulecmd.1.in
msgid "Shutdown the remote running core (amule/amuled).  This will also shut down the text client, since it is unusable without a running core."
msgstr "Atura el nucli remot en execució (amule/amuled).  Això també aturarà el client de text, ja que no es pot fer servir sense un nucli en execució."

#. type: Plain text
#: amulecmd.1.in
msgid "Show statistics tree."
msgstr "Mostra l'arbre d'estadístiques."

#. type: Plain text
#: amulecmd.1.in
msgid "The optional I<E<lt>numberE<gt>> in the range of 0-255 can be passed as argument to this command, which tells how many entries of the client version subtree should be shown. Passing 0, or omitting it means 'unlimited'."
msgstr "A aquesta ordre se li pot passar com a argument el I<E<lt>numberE<gt>> opcional, dins del rang 0-255, que indica quantes entrades del subarbre de versions de client s'han de mostrar. Passar-hi 0, o ometre'l, vol dir «il·limitat»."

#. type: Plain text
#: amulecmd.1.in
msgid "Example: 'statistics 5' will show only the top 5 versions for each client type."
msgstr "Exemple: 'statistics 5' mostrarà només les 5 versions principals de cada tipus de client."

#. type: Plain text
#: amulecmd.1.in
msgid "Show connection status, current up/download speeds, etc."
msgstr "Mostra l'estat de la connexió, les velocitats actuals de pujada i baixada, etc."

#. type: SS
#: amulecmd.1.in amuleweb.1.in
#, no-wrap
msgid "Languages"
msgstr "Idiomes"

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "The I<E<lt>langE<gt>> parameter for the B<-l> option has the following form: I<lang>[B<_>I<LANG>][B<.>I<encoding>][B<@>I<modifier>] where I<lang> is the primary language, I<LANG> is a sublanguage/territory, I<encoding> is the character set to use and I<modifier> allows the user to select a specific instance of localization data within a single category."
msgstr "El paràmetre I<E<lt>langE<gt>> de l'opció B<-l> té la forma següent: I<lang>[B<_>I<LANG>][B<.>I<encoding>][B<@>I<modifier>] on I<lang> és l'idioma principal, I<LANG> és un subidioma o territori, I<encoding> és el joc de caràcters que cal fer servir i I<modifier> permet a l'usuari seleccionar una instància concreta de dades de localització dins d'una mateixa categoria."

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "For example, the following strings are valid:"
msgstr "Per exemple, les cadenes següents són vàlides:"

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "Though all the above strings are accepted as valid language definitions, I<encoding> and I<modifier> are yet unused."
msgstr "Tot i que totes les cadenes anteriors s'accepten com a definicions d'idioma vàlides, I<encoding> i I<modifier> encara no s'utilitzen."

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "In addition to the format above, you can also specify full language names in English - so B<-l german> is also valid and is equal to B<-l de_DE>."
msgstr "A més del format anterior, també podeu especificar els noms complets dels idiomes en anglès, de manera que B<-l german> també és vàlid i equival a B<-l de_DE>."

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "When no locale is defined, either on command-line or in config file, system default language will be used."
msgstr "Quan no es defineix cap configuració regional, ni a la línia d'ordres ni al fitxer de configuració, es farà servir l'idioma predeterminat del sistema."

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "~/.aMule/remote.conf"
msgstr "~/.aMule/remote.conf"

#. type: SH
#: amulecmd.1.in amuleweb.1.in
#, no-wrap
msgid "EXAMPLE"
msgstr "EXEMPLE"

#. type: Plain text
#: amulecmd.1.in
msgid "Typically amulecmd will be first run as:"
msgstr "Normalment amulecmd s'executarà primer així:"

#. type: Plain text
#: amulecmd.1.in
msgid "B<amulecmd> B<-h> I<hostname> B<-p> I<ECport> B<-P> I<ECpassword> B<-w>"
msgstr "B<amulecmd> B<-h> I<hostname> B<-p> I<ECport> B<-P> I<ECpassword> B<-w>"

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "or"
msgstr "o"

#. type: Plain text
#: amulecmd.1.in
msgid "B<amulecmd> B<--create-config-from>=I</home/username/.aMule/amule.conf>"
msgstr "B<amulecmd> B<--create-config-from>=I</home/username/.aMule/amule.conf>"

#. type: Plain text
#: amulecmd.1.in amuleweb.1.in
msgid "These will save settings to I<$HOME/.aMule/remote.conf>, and later you only need to type:"
msgstr "Això desarà la configuració a I<$HOME/.aMule/remote.conf>, i després només caldrà que escriviu:"

#. type: Plain text
#: amulecmd.1.in
msgid "Of course, you don't have to follow this example."
msgstr "Evidentment, no cal que seguiu aquest exemple."

#. type: TH
#: amuled.1.in
#, no-wrap
msgid "AMULED"
msgstr "AMULED"

#. type: TH
#: amuled.1.in
#, no-wrap
msgid "aMule Daemon v@PACKAGE_VERSION@"
msgstr "aMule Daemon v@PACKAGE_VERSION@"

#. type: TH
#: amuled.1.in
#, no-wrap
msgid "aMule Daemon"
msgstr "Dimoni de l'aMule"

#. type: Plain text
#: amuled.1.in
msgid "amuled - the all-platform eMule p2p client - daemonized version"
msgstr "amuled - el client p2p d'eMule multiplataforma - versió dimoni"

#. type: Plain text
#: amuled.1.in ../../src/utils/cas/docs/cas.1.in
msgid "[B<-c> I<E<lt>pathE<gt>>]"
msgstr "[B<-c> I<E<lt>pathE<gt>>]"

#. type: Plain text
#: amuled.1.in
msgid "[B<-p> I<E<lt>pathE<gt>>]"
msgstr "[B<-p> I<E<lt>pathE<gt>>]"

#. type: Plain text
#: amuled.1.in
msgid "Forks to background."
msgstr "Bifurca en segon pla."

#. type: TP
#: amuled.1.in
#, no-wrap
msgid "B<[ -p> I<E<lt>pathE<gt>>, B<--pid-file>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ -p> I<E<lt>pathE<gt>>, B<--pid-file>=I<E<lt>pathE<gt>> B<]>"

#. type: Plain text
#: amuled.1.in
msgid "After fork, create a pid-file in the I<E<lt>pathE<gt>>.  I<E<lt>pathE<gt>> has to contain the filename."
msgstr "Després de bifurcar, crea un fitxer pid a I<E<lt>pathE<gt>>.  I<E<lt>pathE<gt>> ha de contenir el nom del fitxer."

#. type: Plain text
#: amuled.1.in
msgid "Configure EC (External Connections)."
msgstr "Configura les EC (connexions externes)."

#. type: Plain text
#: amuled.1.in
msgid "Enable or disable starting amuled on user login, then exit.  The OS-specific store is selected automatically: Windows registry Run key, macOS LaunchAgent, Linux XDG I<.desktop> autostart entry."
msgstr "Habilita o inhabilita l'inici d'amuled en iniciar la sessió i surt.  El magatzem específic del sistema operatiu se selecciona automàticament: clau Run del registre de Windows, LaunchAgent de macOS, entrada d'inici automàtic XDG I<.desktop> de Linux."

#. type: TP
#: amuled.1.in
#, no-wrap
msgid "B<[ -t> I<E<lt>numE<gt>>, B<--category>=I<E<lt>numE<gt>> B<]>"
msgstr "B<[ -t> I<E<lt>numE<gt>>, B<--category>=I<E<lt>numE<gt>> B<]>"

#. type: TH
#: amulegui.1.in
#, no-wrap
msgid "AMULEGUI"
msgstr "AMULEGUI"

#. type: TH
#: amulegui.1.in
#, no-wrap
msgid "aMuleGUI v@PACKAGE_VERSION@"
msgstr "aMuleGUI v@PACKAGE_VERSION@"

#. type: TH
#: amulegui.1.in
#, no-wrap
msgid "aMuleGUI"
msgstr "aMuleGUI"

#. type: Plain text
#: amulegui.1.in
msgid "amulegui - aMule control program with GUI"
msgstr "amulegui - programa de control de l'aMule amb interfície gràfica"

#. type: Plain text
#: amulegui.1.in
msgid "B<amulegui> is a client program, and can be connected to amule or amuled via EC. You can manage your amule program with it. It provides almost the same functionalities as amule, even if the core works on another computer."
msgstr "B<amulegui> és un programa client i es pot connectar a amule o amuled per EC. Amb ell podeu gestionar el vostre programa aMule. Proporciona gairebé les mateixes funcionalitats que l'amule, encara que el nucli s'executi en un altre ordinador."

#. type: Plain text
#: amulegui.1.in
msgid "Skip connection dialog."
msgstr "Omet el diàleg de connexió."

#. type: Plain text
#: amulegui.1.in
msgid "Enable or disable starting amulegui on user login, then exit.  The OS-specific store is selected automatically: Windows registry Run key, macOS LaunchAgent, Linux XDG I<.desktop> autostart entry."
msgstr "Habilita o inhabilita l'inici d'amulegui en iniciar la sessió i surt.  El magatzem específic del sistema operatiu se selecciona automàticament: clau Run del registre de Windows, LaunchAgent de macOS, entrada d'inici automàtic XDG I<.desktop> de Linux."

#. type: Plain text
#: amulegui.1.in
msgid "Sends an eD2k-link, or every link in an eMule collection file, to the connected core."
msgstr "Envia un enllaç eD2k, o tots els enllaços d'un fitxer de col·lecció d'eMule, al nucli connectat."

#. type: TP
#: amulegui.1.in
#, no-wrap
msgid "I<~/.aMule/remote.conf>"
msgstr "I<~/.aMule/remote.conf>"

#. type: Plain text
#: amulegui.1.in
msgid "Settings, including the core to connect to."
msgstr "Configuració, inclòs el nucli al qual es connecta."

#. type: TP
#: amulegui.1.in
#, no-wrap
msgid "I<~/.aMule/remotelogfile>"
msgstr "I<~/.aMule/remotelogfile>"

#. type: Plain text
#: amulegui.1.in
msgid "The log."
msgstr "El registre."

#. type: TP
#: amulegui.1.in
#, no-wrap
msgid "I<~/.aMule/ED2KLinks>"
msgstr "I<~/.aMule/ED2KLinks>"

#. type: Plain text
#: amulegui.1.in
msgid "Links passed on the command line, waiting to be sent to the core."
msgstr "Enllaços passats a la línia d'ordres, en espera de ser enviats al nucli."

#. type: Plain text
#: amulegui.1.in
msgid "This manpage was written by Julien Delange for Debian E<lt>julien AT gunnm DOT orgE<gt>"
msgstr "Aquesta pàgina de manual la va escriure Julien Delange per a Debian E<lt>julien AT gunnm DOT orgE<gt>"

#. type: Plain text
#: amulegui.1.in
msgid "This manpage was rewritten by Vollstrecker E<lt>amule@vollstreckernet.deE<gt>"
msgstr "Aquesta pàgina de manual la va reescriure Vollstrecker E<lt>amule@vollstreckernet.deE<gt>"

#. type: TH
#: amuleweb.1.in
#, no-wrap
msgid "AMULEWEB"
msgstr "AMULEWEB"

#. type: TH
#: amuleweb.1.in
#, no-wrap
msgid "aMule webserver v@PACKAGE_VERSION@"
msgstr "Servidor web de l'aMule v@PACKAGE_VERSION@"

#. type: Plain text
#: amuleweb.1.in
msgid "amuleweb - aMule web server"
msgstr "amuleweb - servidor web de l'aMule"

#. type: Plain text
#: amuleweb.1.in
msgid "[B<-l> I<E<lt>langE<gt>>]"
msgstr "[B<-l> I<E<lt>langE<gt>>]"

#. type: Plain text
#: amuleweb.1.in
msgid "[B<-t> I<E<lt>nameE<gt>>] [B<-s> I<E<lt>portE<gt>>]"
msgstr "[B<-t> I<E<lt>nameE<gt>>] [B<-s> I<E<lt>portE<gt>>]"

#. type: Plain text
#: amuleweb.1.in
msgid "[B<-U> I<E<lt>portE<gt>>]"
msgstr "[B<-U> I<E<lt>portE<gt>>]"

#. type: Plain text
#: amuleweb.1.in
msgid "[B<-A> I<E<lt>passwordE<gt>>] [B<-G> I<E<lt>passwordE<gt>>]"
msgstr "[B<-A> I<E<lt>passwordE<gt>>] [B<-G> I<E<lt>passwordE<gt>>]"

#. type: Plain text
#: amuleweb.1.in
msgid "[B<--amule-config-file>=I<E<lt>pathE<gt>>]"
msgstr "[B<--amule-config-file>=I<E<lt>pathE<gt>>]"

#. type: Plain text
#: amuleweb.1.in
msgid "B<DEPRECATED:> amuleweb is deprecated and may be removed in aMule 3.2 or later.  It is not being removed yet; consider migrating to amuleapi, the REST/SSE API."
msgstr "B<OBSOLET:> amuleweb està obsolet i es podria eliminar a l'aMule 3.2 o posterior.  Encara no s'elimina; considereu migrar a amuleapi, l'API REST/SSE."

#. type: Plain text
#: amuleweb.1.in
msgid "B<amuleweb> manages your access to amule through a web browser.  You can start amuleweb together with B<amule>(1), or separately, any time later.  Options can be specified via command-line or via config-file.  Command-line options take precedence over config-file options."
msgstr "B<amuleweb> gestiona el vostre accés a l'aMule mitjançant un navegador web.  Podeu iniciar amuleweb juntament amb B<amule>(1), o per separat, en qualsevol moment posterior.  Les opcions es poden especificar per línia d'ordres o per fitxer de configuració.  Les opcions de la línia d'ordres tenen preferència sobre les del fitxer de configuració."

#. type: TP
#: amuleweb.1.in
#, no-wrap
msgid "B<[ -t> I<E<lt>nameE<gt>>, B<--template>=I<E<lt>nameE<gt>> B<]>"
msgstr "B<[ -t> I<E<lt>nameE<gt>>, B<--template>=I<E<lt>nameE<gt>> B<]>"

#. type: Plain text
#: amuleweb.1.in
msgid "Loads the template named I<E<lt>nameE<gt>>. See the B<SKIN SUPPORT> section for details."
msgstr "Carrega la plantilla anomenada I<E<lt>nameE<gt>>. Consulteu la secció B<COMPATIBILITAT AMB APARENCES> per a més detalls."

#. type: TP
#: amuleweb.1.in
#, no-wrap
msgid "B<[ -s> I<E<lt>portE<gt>>, B<--server-port>=I<E<lt>portE<gt>> B<]>"
msgstr "B<[ -s> I<E<lt>portE<gt>>, B<--server-port>=I<E<lt>portE<gt>> B<]>"

#. type: Plain text
#: amuleweb.1.in
msgid "Webserver's HTTP port. This is the port you must point your browser to (default: I<4711>)."
msgstr "Port HTTP del servidor web. És el port al qual heu d'apuntar el navegador (predeterminat: I<4711>)."

#. type: Plain text
#: amuleweb.1.in
msgid "Enable UPnP."
msgstr "Habilita l'UPnP."

#. type: TP
#: amuleweb.1.in
#, no-wrap
msgid "B<[ -U> I<E<lt>portE<gt>>, B<--upnp-port>=I<E<lt>portE<gt>> B<]>"
msgstr "B<[ -U> I<E<lt>portE<gt>>, B<--upnp-port>=I<E<lt>portE<gt>> B<]>"

#. type: Plain text
#: amuleweb.1.in
msgid "UPnP port."
msgstr "Port UPnP."

#. type: Plain text
#: amuleweb.1.in
msgid "Enables using gzip compression in HTTP traffic to save bandwidth."
msgstr "Habilita l'ús de la compressió gzip al trànsit HTTP per estalviar amplada de banda."

#. type: Plain text
#: amuleweb.1.in
msgid "Disables using gzip compression (this is the default)."
msgstr "Inhabilita l'ús de la compressió gzip (és el valor predeterminat)."

#. type: TP
#: amuleweb.1.in
#, no-wrap
msgid "B<[ -A> I<E<lt>passwdE<gt>>, B<--admin-pass>=I<E<lt>passwdE<gt>> B<]>"
msgstr "B<[ -A> I<E<lt>passwdE<gt>>, B<--admin-pass>=I<E<lt>passwdE<gt>> B<]>"

#. type: Plain text
#: amuleweb.1.in
msgid "Full access password for webserver."
msgstr "Contrasenya d'accés complet al servidor web."

#. type: TP
#: amuleweb.1.in
#, no-wrap
msgid "B<[ -G> I<E<lt>passwdE<gt>>, B<--guest-pass>=I<E<lt>passwdE<gt>> B<]>"
msgstr "B<[ -G> I<E<lt>passwdE<gt>>, B<--guest-pass>=I<E<lt>passwdE<gt>> B<]>"

#. type: Plain text
#: amuleweb.1.in
msgid "Guest password for webserver."
msgstr "Contrasenya de convidat del servidor web."

#. type: Plain text
#: amuleweb.1.in
msgid "Allows guest access."
msgstr "Permet l'accés de convidats."

#. type: Plain text
#: amuleweb.1.in
msgid "Denies guest access (default)."
msgstr "Denega l'accés de convidats (predeterminat)."

#. type: Plain text
#: amuleweb.1.in
msgid "Load/save webserver settings from/to remote aMule.  This causes amuleweb to ignore command-line and config-file settings, and load them from aMule.  When saving preferences none will be written to the config file, but to aMule.  (Of course, this works only for those settings that can be set in aMule's Preferences-E<gt>Remote Controls.)"
msgstr "Carrega o desa la configuració del servidor web des de o cap a l'aMule remot.  Això fa que amuleweb ignori la configuració de la línia d'ordres i del fitxer de configuració, i que la carregui de l'aMule.  En desar les preferències no se n'escriurà cap al fitxer de configuració, sinó a l'aMule.  (Evidentment, això només funciona per als paràmetres que es poden definir a Preferències-E<gt>Controls remots de l'aMule.)"

#. type: Plain text
#: amuleweb.1.in
msgid "Disable PHP interpreter (deprecated)"
msgstr "Inhabilita l'intèrpret de PHP (obsolet)"

#. type: Plain text
#: amuleweb.1.in
msgid "Recompiles PHP pages on each request."
msgstr "Torna a compilar les pàgines PHP a cada petició."

#. type: TP
#: amuleweb.1.in
#, no-wrap
msgid "B<[ --amule-config-file>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ --amule-config-file>=I<E<lt>pathE<gt>> B<]>"

#. type: Plain text
#: amuleweb.1.in
msgid "aMule config file path.  B<DO NOT USE DIRECTLY!> aMule uses this option when starting amuleweb at aMule startup.  This option causes all other command-line and config-file settings to be ignored, preferences to be read from the given config file, and also implies the B<-q -L> options."
msgstr "Camí del fitxer de configuració de l'aMule.  B<NO HO FEU SERVIR DIRECTAMENT!> L'aMule utilitza aquesta opció quan inicia amuleweb en iniciar-se.  Aquesta opció fa que s'ignorin tots els altres paràmetres de la línia d'ordres i del fitxer de configuració, que les preferències es llegeixin del fitxer de configuració indicat, i també implica les opcions B<-q -L>."

#. type: SH
#: amuleweb.1.in
#, no-wrap
msgid "SKIN SUPPORT"
msgstr "COMPATIBILITAT AMB APARENCES"

#. type: Plain text
#: amuleweb.1.in
msgid "B<amuleweb> is capable of displaying information in different skins.  These skins are called templates, and you can make amuleweb load a specific template via the B<-t> command line option.  Templates are searched in two places: first in I<~/.aMule/webserver/> and then in I</usr/share/amule/webserver/> if you installed with --prefix=/usr."
msgstr "B<amuleweb> pot mostrar la informació amb aparences diferents.  Aquestes aparences s'anomenen plantilles, i podeu fer que amuleweb en carregui una de concreta amb l'opció B<-t> de la línia d'ordres.  Les plantilles es busquen en dos llocs: primer a I<~/.aMule/webserver/> i després a I</usr/share/amule/webserver/> si heu instal·lat amb --prefix=/usr."

#. type: Plain text
#: amuleweb.1.in
msgid "Each template must be in a subdirectory of the template name, and this directory must contain all files the template needs."
msgstr "Cada plantilla ha de ser en un subdirectori amb el nom de la plantilla, i aquest directori ha de contenir tots els fitxers que la plantilla necessita."

#. type: Plain text
#: amuleweb.1.in
msgid "~/.aMule/webserver/"
msgstr "~/.aMule/webserver/"

#. type: Plain text
#: amuleweb.1.in
msgid "I<$(pkgdatadir)>/webserver/"
msgstr "I<$(pkgdatadir)>/webserver/"

#. type: Plain text
#: amuleweb.1.in
msgid "Typically amuleweb will be first run as:"
msgstr "Normalment amuleweb s'executarà primer així:"

#. type: Plain text
#: amuleweb.1.in
msgid "B<amuleweb> B<-h> I<hostname> B<-p> I<ECport> B<-P> I<ECpassword> B<-s> I<HTTPport> B<-A> I<AdminPassword> B<-w>"
msgstr "B<amuleweb> B<-h> I<hostname> B<-p> I<ECport> B<-P> I<ECpassword> B<-s> I<HTTPport> B<-A> I<AdminPassword> B<-w>"

#. type: Plain text
#: amuleweb.1.in
msgid "B<amuleweb> B<--create-config-from>=I</home/username/.aMule/amule.conf>"
msgstr "B<amuleweb> B<--create-config-from>=I</home/username/.aMule/amule.conf>"

#. type: Plain text
#: amuleweb.1.in
msgid "Of course, you may specify any more or less options on the first example line, and you may also totally omit it."
msgstr "Evidentment, podeu especificar més o menys opcions a la primera línia d'exemple, i també la podeu ometre del tot."

#. type: TH
#: ed2k.1.in
#, no-wrap
msgid "ED2K"
msgstr "ED2K"

#. type: TH
#: ed2k.1.in
#, no-wrap
msgid "aMule eD2k link parser v1.5.1"
msgstr "Analitzador d'enllaços eD2k de l'aMule v1.5.1"

#. type: Plain text
#: ed2k.1.in
msgid "ed2k - aMule eD2k link parser"
msgstr "ed2k - analitzador d'enllaços eD2k de l'aMule"

#. type: Plain text
#: ed2k.1.in
msgid "[B<-c> I<E<lt>pathE<gt>>] [B<-t> I<E<lt>numE<gt>>]"
msgstr "[B<-c> I<E<lt>pathE<gt>>] [B<-t> I<E<lt>numE<gt>>]"

#. type: Plain text
#: ed2k.1.in
msgid "I<E<lt>eD2k-linkE<gt>>"
msgstr "I<E<lt>eD2k-linkE<gt>>"

#. type: Plain text
#: ed2k.1.in
msgid "Sends the given I<E<lt>eD2k-linkE<gt>> to aMule, i.e. writes it to the file ~/.aMule/ED2KLinks, which will be checked by aMule every second for links."
msgstr "Envia l'enllaç I<E<lt>eD2k-linkE<gt>> indicat a l'aMule, és a dir, l'escriu al fitxer ~/.aMule/ED2KLinks, que l'aMule comprova cada segon per veure si hi ha enllaços."

#. type: TP
#: ed2k.1.in
#, no-wrap
msgid "B<[ -t> I<E<lt>numE<gt>>, B<--category> I<E<lt>numE<gt>> B<]>"
msgstr "B<[ -t> I<E<lt>numE<gt>>, B<--category> I<E<lt>numE<gt>> B<]>"

#. type: Plain text
#: ed2k.1.in
msgid "Set category for passed eD2k links to I<E<lt>numE<gt>>.  Unlike B<--config-dir>, the parser reads the value as the next argument and does not accept B<--category>=I<E<lt>numE<gt>> syntax."
msgstr "Estableix la categoria dels enllaços eD2k passats a I<E<lt>numE<gt>>.  A diferència de B<--config-dir>, l'analitzador llegeix el valor com a argument següent i no accepta la sintaxi B<--category>=I<E<lt>numE<gt>>."

#. type: Plain text
#: ed2k.1.in
msgid "Loads all links found in the emulecollection given as I<E<lt>ed2k-linkE<gt>>"
msgstr "Carrega tots els enllaços que es troben a l'emulecollection indicada com a I<E<lt>ed2k-linkE<gt>>"

#. type: Plain text
#: ed2k.1.in
msgid "Lists all links found in the emulecollection given as I<E<lt>ed2k-linkE<gt>>"
msgstr "Llista tots els enllaços que es troben a l'emulecollection indicada com a I<E<lt>ed2k-linkE<gt>>"

#. type: TP
#: ed2k.1.in
#, no-wrap
msgid "B<[ eD2k-link ]>"
msgstr "B<[ eD2k-link ]>"

#. type: Plain text
#: ed2k.1.in
msgid "Adds an eD2k-link to the core."
msgstr "Afegeix un enllaç eD2k al nucli."

#. type: Plain text
#: ed2k.1.in
msgid "a magnet link;"
msgstr "un enllaç magnet;"

#. type: Plain text
#: ed2k.1.in
msgid "an emulecollection file."
msgstr "un fitxer emulecollection."

#. type: Plain text
#: ed2k.1.in
msgid "B<The order in which you give the parameters is important.> You can give more than one link, and every link can have it's own params.  For example B<ed2k E<lt>link1E<gt> -t2 E<lt>link2E<gt>> will download I<E<lt>link1E<gt>> in standard category and I<E<lt>link2E<gt>> in category 2."
msgstr "B<L'ordre en què doneu els paràmetres és important.> Podeu donar més d'un enllaç, i cada enllaç pot tenir els seus propis paràmetres.  Per exemple, B<ed2k E<lt>link1E<gt> -t2 E<lt>link2E<gt>> baixarà I<E<lt>link1E<gt>> a la categoria estàndard i I<E<lt>link2E<gt>> a la categoria 2."

#. type: Plain text
#: ed2k.1.in
msgid "~/.aMule/ED2KLinks"
msgstr "~/.aMule/ED2KLinks"

#. type: TH
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#, no-wrap
msgid "ALC"
msgstr "ALC"

#. type: TH
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#, no-wrap
msgid "aLinkCreator"
msgstr "aLinkCreator"

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alc.1.in
msgid "aLinkCreator - the aMule eD2k link creator"
msgstr "aLinkCreator - el creador d'enllaços eD2k de l'aMule"

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alc.1.in
msgid "B<alc> is a graphical utility to create an eD2k link to any file on your computer."
msgstr "B<alc> és una utilitat gràfica per crear un enllaç eD2k a qualsevol fitxer del vostre ordinador."

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/wxCas/docs/wxcas.1.in
msgid "This app doesn't take any arguments."
msgstr "Aquesta aplicació no accepta cap argument."

#. type: TH
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#, no-wrap
msgid "ALCC"
msgstr "ALCC"

#. type: TH
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#, no-wrap
msgid "aMule eD2k links calculator"
msgstr "Calculadora d'enllaços eD2k de l'aMule"

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
msgid "alcc - text based eD2k links calculator for aMule"
msgstr "alcc - calculadora d'enllaços eD2k per a l'aMule, basada en text"

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
msgid "I<E<lt>inputfiles_listE<gt>>"
msgstr "I<E<lt>inputfiles_listE<gt>>"

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
msgid "Compute the eD2k links of all the input files given in the I<E<lt>inputfiles_listE<gt>> (There can be one or more files)."
msgstr "Calcula els enllaços eD2k de tots els fitxers d'entrada indicats a I<E<lt>inputfiles_listE<gt>> (hi pot haver un fitxer o més)."

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
msgid "Compute and add part hashes to the computed eD2k links."
msgstr "Calcula i afegeix els hash de les parts als enllaços eD2k calculats."

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
msgid "Be verbose - show also calculation steps."
msgstr "Mode detallat: mostra també els passos del càlcul."

#. type: TH
#: ../../src/utils/cas/docs/cas.1.in
#, no-wrap
msgid "CAS"
msgstr "CAS"

#. type: TH
#: ../../src/utils/cas/docs/cas.1.in
#, no-wrap
msgid "cas v0.8"
msgstr "cas v0.8"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "cas - c aMule statistics"
msgstr "cas - estadístiques de l'aMule en c"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "B<cas> is a program for displaying the contents of your aMule online signature file to console (in a human readable form). For this to work, you must enable the \"Online Signature\" option in aMule's preferences."
msgstr "B<cas> és un programa per mostrar per consola el contingut del fitxer de signatura en línia de l'aMule (en un format llegible per a persones). Perquè funcioni, heu d'activar l'opció «Signatura en línia» a les preferències de l'aMule."

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "Writes the online signature picture.  The long form B<--picture> accepts an optional I<=E<lt>PATHE<gt>> to specify the output location; the short forms B<-o> / B<-P> do not (B<-P> requires an immediately following I<E<lt>PATHE<gt>> argument, and B<-o> is a no-argument switch).  Requires GD support compiled in (I<__GD__>); this option is silently ignored otherwise."
msgstr "Escriu la imatge de la signatura en línia.  La forma llarga B<--picture> accepta un I<=E<lt>PATHE<gt>> opcional per especificar la ubicació de sortida; les formes curtes B<-o> / B<-P> no ho fan (B<-P> requereix un argument I<E<lt>PATHE<gt>> immediatament després, i B<-o> és un commutador sense argument).  Requereix compatibilitat amb GD compilada (I<__GD__>); altrament, aquesta opció s'ignora silenciosament."

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "HTML page with stats and picture.  The long form B<--html> accepts an optional I<=E<lt>PATHE<gt>> to specify the output location; the short forms B<-p> / B<-H> do not (B<-H> requires an immediately following I<E<lt>PATHE<gt>> argument, and B<-p> is a no-argument switch)."
msgstr "Pàgina HTML amb estadístiques i imatge.  La forma llarga B<--html> accepta un I<=E<lt>PATHE<gt>> opcional per especificar la ubicació de sortida; les formes curtes B<-p> / B<-H> no ho fan (B<-H> requereix un argument I<E<lt>PATHE<gt>> immediatament després, i B<-p> és un commutador sense argument)."

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "Without any options, it prints online signature data to stdout."
msgstr "Sense cap opció, escriu les dades de la signatura en línia a stdout."

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "B<cas> was written by Pedro de Oliveira E<lt>falso@rdk.homeip.netE<gt>"
msgstr "B<cas> el va escriure Pedro de Oliveira E<lt>falso@rdk.homeip.netE<gt>"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "~/.aMule/casrc"
msgstr "~/.aMule/casrc"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "aMule-online-sign.png (or .jpg, when B<-o> / B<--picture> is used and GD is available)"
msgstr "aMule-online-sign.png (o .jpg, quan es fa servir B<-o> / B<--picture> i GD està disponible)"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "aMule-online-sign.html (when B<-p> / B<--html> is used)"
msgstr "aMule-online-sign.html (quan es fa servir B<-p> / B<--html>)"

#. type: TH
#: ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "WXCAS"
msgstr "WXCAS"

#. type: TH
#: ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "wxCas"
msgstr "wxCas"

#. type: Plain text
#: ../../src/utils/wxCas/docs/wxcas.1.in
msgid "wxcas - wx c aMule statistics"
msgstr "wxcas - estadístiques de l'aMule en wx c"

#. type: Plain text
#: ../../src/utils/wxCas/docs/wxcas.1.in
msgid "B<wxcas> is a program for displaying the contents of your online signature file in a nice wx Window on your Desktop.  For this to work, you must enable the \"Online Signature\" option in aMule's preferences."
msgstr "B<wxcas> és un programa per mostrar el contingut del fitxer de signatura en línia en una finestra wx a l'escriptori.  Perquè funcioni, heu d'activar l'opció «Signatura en línia» a les preferències de l'aMule."

#. type: Plain text
#: ../../src/utils/wxCas/docs/wxcas.1.in
msgid "Based on Pedro de Oliveira's B<cas>(1).  B<wxcas> was written by ThePolish E<lt>thepolish@vipmail.ruE<gt>"
msgstr "Basat en el B<cas>(1) de Pedro de Oliveira.  B<wxcas> el va escriure ThePolish E<lt>thepolish@vipmail.ruE<gt>"

#~ msgid "The I<E<lt>numberE<gt>> of a file from the last search has to be given.  Example: 'download 12' will start to download the file with the number 12 of the previous search."
#~ msgstr "Cal indicar el I<E<lt>numberE<gt>> d'un fitxer de l'última cerca.  Exemple: «download 12» començarà a baixar el fitxer amb el número 12 de la cerca anterior."

#~ msgid "Shows the progress of an on-going search."
#~ msgstr "Mostra el progrés d'una cerca en curs."

#~ msgid "Shows you the results of the last search."
#~ msgstr "Mostra els resultats de l'última cerca."

#~ msgid "[B<-t> I<E<lt>numE<gt>>]"
#~ msgstr "[B<-t> I<E<lt>numE<gt>>]"
