msgstr "本手冊頁由 Vollstrecker E<lt>amule@vollstreckernet.deE<gt> 撰寫"

#. type: TH
#: amulecmd.1.in
#, no-wrap
msgid "AMULECMD"
msgstr "AMULECMD"

#. type: TH
#: amulecmd.1.in
#, no-wrap
msgid "aMuleCmd v@PACKAGE_VERSION@"
msgstr "aMuleCmd v@PACKAGE_VERSION@"

#. type: TH
#: amulecmd.1.in ed2k.1.in ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "aMule utilities"
msgstr "aMule 的工具程式"

#. type: Plain text
#: amulecmd.1.in
msgid "amulecmd - Console-based program to control aMule"
msgstr "amulecmd - 從終端機控制 aMule 的程式"

#. type: Plain text
#: amulecmd.1.in
msgid "[B<-h> I<E<lt>hostE<gt>>] [B<-p> I<E<lt>portE<gt>>]"
msgstr "[B<-h> I<E<lt>主機E<gt>>] [B<-p> I<E<lt>連接埠E<gt>>]"

#. type: Plain text
#: amulecmd.1.in
msgid "[B<-f> I<E<lt>pathE<gt>>]"
msgstr "[B<-f> I<E<lt>路徑E<gt>>]"

#. type: Plain text
#: amulecmd.1.in
msgid "[B<-l> I<E<lt>langE<gt>>] {B< >[B<-w>]B< >|B< >[B<-c> I<E<lt>commandE<gt>>]B< >}"
msgstr "[B<-l> I<E<lt>語言E<gt>>] {B< >[B<-w>]B< >|B< >[B<-c> I<E<lt>指令E<gt>>]B< >}"

#. type: Plain text
#: amulecmd.1.in
msgid "B<amulecmd> is a console-based client to control aMule."
msgstr "B<amulecmd> 是用來從終端機控制 aMule 的用戶端。"

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<[ -h> I<E<lt>hostE<gt>>, B<--host>=I<E<lt>hostE<gt>> B<]>"
msgstr "B<[ -h> I<E<lt>主機E<gt>>, B<--host>=I<E<lt>主機E<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in
msgid "Host where aMule is running (default: I<127.0.0.1>).  I<E<lt>hostE<gt>> might be an IP address or a DNS name"
msgstr "執行 aMule 的主機（預設為 I<127.0.0.1>）。I<E<lt>主機E<gt>> 可以是 IP 位址或網域名稱"

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<[ -p> I<E<lt>portE<gt>>, B<--port>=I<E<lt>portE<gt>> B<]>"
msgstr "B<[ -p> I<E<lt>連接埠E<gt>>, B<--port>=I<E<lt>連接埠E<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in
msgid "aMule's port for External Connections, as set in Preferences-E<gt>Remote Controls (default: I<4712>)"
msgstr "aMule 的外部連線連接埠，可在「偏好設定」E<gt>「遠端控制」中設定（預設為 I<4712>）"

#. type: Plain text
#: amulecmd.1.in
msgid "Read the External Connections password from the first line of stdin. Input is hidden on a terminal. Later lines stay on stdin, where amulecmd reads its commands. With B<-w> it replaces a saved password, even when an older file holds two. Without this option and without a saved password, amulecmd asks for the password the same way, so piped input then also starts with the password."
msgstr "從標準輸入的第一行讀取外部連線密碼。在終端機輸入時不會顯示密碼。後續各行仍留在標準輸入，由 amulecmd 當作指令讀取。搭配 B<-w> 使用時會取代已儲存的密碼，即使舊設定檔存有兩組密碼也一樣。如果未指定這個選項，也沒有已儲存的密碼，amulecmd 仍會用相同方式要求輸入密碼，因此透過管線提供輸入時，第一行也要放密碼。"

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<[ -f> I<E<lt>pathE<gt>>, B<--config-file>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ -f> I<E<lt>路徑E<gt>>, B<--config-file>=I<E<lt>路徑E<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in
msgid "Use the given configuration file.  Default configuration file is I<~/.aMule/remote.conf>"
msgstr "使用指定的設定檔，預設是 I<~/.aMule/remote.conf>"

#. type: Plain text
#: amulecmd.1.in
msgid "Do not print any output to stdout."
msgstr "不輸出任何內容到標準輸出 (stdout)。"

#. type: Plain text
#: amulecmd.1.in
msgid "Be verbose - show also debug messages."
msgstr "顯示詳細資訊，包括偵錯訊息。"

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<[ -l> I<E<lt>langE<gt>>, B<--locale>=I<E<lt>langE<gt>> B<]>"
msgstr "B<[ -l> I<E<lt>語言E<gt>>, B<--locale>=I<E<lt>語言E<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in
msgid "Sets program locale (language).  See the B<NOTES> section for the description of the I<E<lt>langE<gt>> parameter."
msgstr "設定程式的語系（語言）。I<E<lt>語言E<gt>> 參數的用法請參閱「B<附註>」。"

#. type: Plain text
#: amulecmd.1.in
msgid "Write command line options to config file and exit"
msgstr "將命令列選項寫入設定檔，然後結束程式"

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<[ -c> I<E<lt>commandE<gt>>, B<--command>=I<E<lt>commandE<gt>> B<]>"
msgstr "B<[ -c> I<E<lt>指令E<gt>>, B<--command>=I<E<lt>指令E<gt>> B<]>"

#. type: Plain text
#: amulecmd.1.in
msgid "Execute I<E<lt>commandE<gt>> as if it was entered at amulecmd's prompt and exit."
msgstr "執行 I<E<lt>指令E<gt>>，效果和在 amulecmd 的提示字元下直接輸入相同，然後結束程式。"

#. type: Plain text
#: amulecmd.1.in
msgid "Force ZLIB compression on the External Connection link regardless of the dialed-IP locality.  Useful when the server side is reachable over a VPN tunnel that resolves to a LAN IP and the heuristic would otherwise skip compression."
msgstr "一律在外部連線上使用 ZLIB 壓縮。若伺服器透過 VPN 通道連線，且程式連線時使用的是區域網路 IP 位址，原本的判斷機制可能會略過壓縮，此時可使用這個選項。"

#. type: Plain text
#: amulecmd.1.in
msgid "Separate the fields of the list commands with spaces, as earlier versions did, instead of tabs.  Client names and file names may contain spaces, so the default tab separator is what lets a script split a row back into its fields; use this only for scripts written against the older output."
msgstr "讓清單指令沿用舊版格式，以空格分隔欄位。由於用戶端名稱和檔名可能含有空格，使用預設的定位字元才能讓指令碼把每一列正確拆回各個欄位。只有為舊版輸出格式編寫的指令碼才需要這個選項。"

#. type: SH
#: amulecmd.1.in
#, no-wrap
msgid "COMMANDS"
msgstr "指令"

#. type: Plain text
#: amulecmd.1.in
msgid "All commands are case insensitive."
msgstr "所有指令都不分大小寫。"

#. type: Plain text
#: amulecmd.1.in
msgid "Adds an eD2k-link or a magnet-link to the core."
msgstr "將 eD2k 或 magnet 連結加入核心程式。"

#. type: Plain text
#: amulecmd.1.in
msgid "a serverlist link, in which case all servers in the list will be added to the server list."
msgstr "伺服器清單連結，會一次加入清單中的所有伺服器。"

#. type: Plain text
#: amulecmd.1.in
msgid "The magnet link must contain the eD2k hash and file length."
msgstr "magnet 連結必須包含 eD2k 雜湊值與檔案大小。"

#. type: Plain text
#: amulecmd.1.in
msgid "Cancels the download specified by I<E<lt>hashE<gt>> or I<E<lt>numberE<gt>>. To get the value use B<show>."
msgstr "依 I<E<lt>雜湊值E<gt>> 或 I<E<lt>編號E<gt>> 取消指定的下載項目。可用 B<show> 查詢這些值。"

#. type: Plain text
#: amulecmd.1.in
msgid "Connect to the network."
msgstr "連線到網路。"

#. type: Plain text
#: amulecmd.1.in
msgid "This will connect to all networks that are enabled in Preferences."
msgstr "會連線到所有在偏好設定中啟用的網路。"

#. type: Plain text
#: amulecmd.1.in
msgid "With the optional parameter you can specify which network to connect to. Giving a server address in the form of IP:Port (where IP is either a dotted decimal IPv4 address or a resolvable DNS name) aMule will connect to that server only."
msgstr "可用選填參數指定要連線的網路。若以 IP:Port 格式指定伺服器位址，aMule 就只會連線到該伺服器。IP 可以是以句點分隔的十進位 IPv4 位址，或可由 DNS 解析的網域名稱。"

#. type: Plain text
#: amulecmd.1.in
msgid "Disconnect from all networks you are connected to, or just disconnect from the specified network."
msgstr "中斷所有已連線的網路，或只中斷指定的網路連線。"

#. type: Plain text
#: amulecmd.1.in
msgid "Start downloading a file."
msgstr "開始下載檔案。"

#. type: Plain text
#: amulecmd.1.in
msgid "Give the I<E<lt>numberE<gt>> of a file as listed by B<results>, optionally followed by a search I<E<lt>idE<gt>> (as printed by B<search>). Without an id, the number refers to the last B<results> output, or to the most recently started search if nothing was listed yet.  Example: 'download 12' downloads file 12 of the last results; 'download 12 3' downloads file 12 of search 3."
msgstr "輸入 B<results> 列出的檔案 I<E<lt>編號E<gt>>，後面可以加上 B<search> 顯示的搜尋 I<E<lt>IDE<gt>>。省略 ID 時，編號對應上一次 B<results> 列出的結果。如果還沒列出任何結果，就以最近發起的搜尋為準。例如，'download 12' 會下載上次列出的編號 12 的檔案，'download 12 3' 則會下載搜尋 ID 為 3 的編號 12 的檔案。"

#. type: Plain text
#: amulecmd.1.in
msgid "Disconnect from amule/amuled and quit amulecmd."
msgstr "中斷與 amule/amuled 的連線，然後結束 amulecmd。"

#. type: Plain text
#: amulecmd.1.in
msgid "Get and display a preference value."
msgstr "取得並顯示某個偏好設定的值。"

#. type: Plain text
#: amulecmd.1.in
msgid "Available values for I<E<lt>whatE<gt>>:"
msgstr "I<E<lt>目標E<gt>> 參數可用的值："

#. type: Plain text
#: amulecmd.1.in
msgid "Get bandwidth limits."
msgstr "取得頻寬限制。"

#. type: Plain text
#: amulecmd.1.in
msgid "Get IPFilter preferences."
msgstr "取得 IP 過濾器的偏好設定。"

#. type: Plain text
#: amulecmd.1.in
msgid "Prints a short usage description.  If called without parameter, it shows a list of available commands.  If called with I<E<lt>commandE<gt>>, it shows a short description of the given command."
msgstr "顯示簡短的使用說明。省略參數時會列出可用的指令；指定 I<E<lt>指令E<gt>> 時會顯示該指令的簡短說明。"

#. type: Plain text
#: amulecmd.1.in
msgid "Pauses the download specified by I<E<lt>hashE<gt>> or I<E<lt>numberE<gt>>. To get the value use B<show>."
msgstr "依 I<E<lt>雜湊值E<gt>> 或 I<E<lt>編號E<gt>> 暫停指定的下載項目。可用 B<show> 查詢這些值。"

#. type: Plain text
#: amulecmd.1.in
msgid "Set priority of a download specified by I<E<lt>hashE<gt>> or I<E<lt>numberE<gt>>."
msgstr "依 I<E<lt>雜湊值E<gt>> 或 I<E<lt>編號E<gt>> 指定下載項目，再設定其優先等級。"

#. type: Plain text
#: amulecmd.1.in
msgid "Available values for I<E<lt>priorityE<gt>>:"
msgstr "I<E<lt>優先等級E<gt>> 參數可用的值："

#. type: Plain text
#: amulecmd.1.in
msgid "Automatic priority."
msgstr "自動設定優先等級。"

#. type: Plain text
#: amulecmd.1.in
msgid "High priority."
msgstr "高優先等級。"

#. type: Plain text
#: amulecmd.1.in
msgid "Low priority."
msgstr "低優先等級。"

#. type: Plain text
#: amulecmd.1.in
msgid "Normal priority."
msgstr "一般優先等級。"

#. type: Plain text
#: amulecmd.1.in
msgid "Shows the progress of an on-going search. Optionally takes a search I<E<lt>idE<gt>> (as printed by B<search>); with no id, shows the most recently started search."
msgstr "顯示搜尋進度。可以輸入 B<search> 顯示的搜尋 I<E<lt>IDE<gt>>，省略時會顯示最近發起的搜尋進度。"

#. type: Plain text
#: amulecmd.1.in
msgid "A synonym of the B<exit> command."
msgstr "B<exit> 指令的別名。"

#. type: Plain text
#: amulecmd.1.in
msgid "Reloads a given object."
msgstr "重新載入指定的物件。"

#. type: Plain text
#: amulecmd.1.in
msgid "Reload shared files list."
msgstr "重新載入分享檔案清單。"

#. type: Plain text
#: amulecmd.1.in
msgid "Reload IP filter tables."
msgstr "重新載入 IP 過濾表。"

#. type: Plain text
#: amulecmd.1.in
msgid "Reset the log."
msgstr "清除日誌。"

#. type: Plain text
#: amulecmd.1.in
msgid "Shows you the results of a search. Optionally takes a search I<E<lt>idE<gt>> (as printed by B<search>); with no id, shows the most recently started search.  Several searches can be kept on the daemon at once and addressed by id."
msgstr "顯示搜尋結果。可以輸入 B<search> 顯示的搜尋 I<E<lt>IDE<gt>>，省略時會顯示最近發起的搜尋結果。背景服務可同時保留多筆搜尋，並讓你用 ID 查詢指定的搜尋。"

#. type: Plain text
#: amulecmd.1.in
msgid "Resumes the download specified by I<E<lt>hashE<gt>> or I<E<lt>numberE<gt>>. To get the value use B<show>."
msgstr "依 I<E<lt>雜湊值E<gt>> 或 I<E<lt>編號E<gt>> 繼續指定的下載項目。可用 B<show> 查詢這些值。"

#. type: Plain text
#: amulecmd.1.in
msgid "Lists retained search IDs and queries, including searches started by other clients."
msgstr "列出保留的搜尋 ID 和搜尋條件，也包括其他用戶端發起的搜尋。"

#. type: Plain text
#: amulecmd.1.in
msgid "Stops activity for the specified search while retaining its results."
msgstr "停止指定的搜尋，並保留已取得的結果。"

#. type: Plain text
#: amulecmd.1.in
msgid "Requests more Kad results for the specified search. Further results are not guaranteed.  The reply reports whether later requests remain possible, or whether that information is unavailable from an older daemon."
msgstr "要求指定的 Kad 搜尋尋找更多結果。這不一定會找到新結果。回應會說明之後是否還能繼續要求更多結果。如果背景服務版本較舊，也可能回報無法得知。"

#. type: Plain text
#: amulecmd.1.in
msgid "These management commands require daemon support for search listing and multiple searches.  Use an explicit ID from B<search list> for stop and more."
msgstr "這些管理指令要求背景服務支援列出搜尋及同時保留多筆搜尋。執行 stop 或 more 時，請明確帶入 B<search list> 列出的搜尋 ID。"

#. type: Plain text
#: amulecmd.1.in
msgid "Makes a search for the given I<E<lt>keywordE<gt>>. A search type and a keyword to search is mandatory to do this.  Example: 'search kad amule' performs a kad search for 'amule'.  Prints a search id; pass it to B<results> or B<progress> to address this search. Several searches can run at once, each with its own id."
msgstr "搜尋指定的 I<E<lt>關鍵字E<gt>>。必須提供搜尋類型和關鍵字。例如，'search kad amule' 會在 Kad 網路搜尋 'amule'。指令會顯示搜尋 ID，可交給 B<results> 或 B<progress> 查詢這筆搜尋。多筆搜尋可以同時進行，各自有不同的 ID。"

#. type: Plain text
#: amulecmd.1.in
msgid "Available search types:"
msgstr "可用的搜尋類型："

#. type: Plain text
#: amulecmd.1.in
msgid "Searches eD2k and Kad together, using the available network if the other cannot start. Requires a daemon advertising All search support; older daemons return a clear error without starting a search. Example: 'search all amule'."
msgstr "同時在 eD2k 和 Kad 網路搜尋。若其中一個網路無法開始搜尋，會改用可用的那一個。背景服務必須表明支援 All 搜尋；舊版會回報錯誤，且不會開始搜尋。例如，'search all amule'。"

#. type: Plain text
#: amulecmd.1.in
msgid "Performs a global search."
msgstr "搜尋所有 eD2k 伺服器。"

#. type: Plain text
#: amulecmd.1.in
msgid "Performs a search on the Kademlia network."
msgstr "在 Kademlia 網路搜尋。"

#. type: Plain text
#: amulecmd.1.in
msgid "Performs a local search."
msgstr "搜尋目前連線的 eD2k 伺服器。"

#. type: Plain text
#: amulecmd.1.in
msgid "Optional filters can be placed before, after, or interleaved with the search keyword(s):"
msgstr "選填的篩選條件可放在搜尋關鍵字之前、之後，也可穿插在多個關鍵字之間："

#. type: Plain text
#: amulecmd.1.in
msgid "Restrict results to the given file type."
msgstr "只顯示指定檔案類型的結果。"

#. type: Plain text
#: amulecmd.1.in
msgid "Restrict results to a specific file extension (e.g.\\ I<iso>, I<mp3>)."
msgstr "只顯示指定副檔名的結果，例如\\ I<iso> 或 I<mp3>。"

#. type: Plain text
#: amulecmd.1.in
msgid "Minimum number of sources a result must report."
msgstr "只顯示來源數至少達到指定值的結果。"

#. type: Plain text
#: amulecmd.1.in
msgid "Smallest file size to return. Suffixes use binary multipliers (K = 1024, M = K\\(mu1024, G = M\\(mu1024); no suffix means bytes."
msgstr "只顯示檔案大小至少達到指定值的結果。單位後綴採二進位倍率（K = 1024，M = K\\(mu1024，G = M\\(mu1024），省略後綴時以位元組為單位。"

#. type: Plain text
#: amulecmd.1.in
msgid "Largest file size to return. Same suffixes as B<--min-size>."
msgstr "只顯示檔案大小不超過指定值的結果。單位後綴與 B<--min-size> 相同。"

#. type: Plain text
#: amulecmd.1.in
msgid "Media filters:"
msgstr "媒體篩選條件："

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<--min-bitrate> I<E<lt>kbpsE<gt>>"
msgstr "B<--min-bitrate> I<E<lt>kbpsE<gt>>"

#. type: Plain text
#: amulecmd.1.in
msgid "Minimum bitrate as a whole number from 0 to 1000000."
msgstr "最低位元速率，須為 0 至 1000000 的整數。"

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<--min-duration> I<E<lt>secondsE<gt>>"
msgstr "B<--min-duration> I<E<lt>秒數E<gt>>"

#. type: Plain text
#: amulecmd.1.in
msgid "Minimum duration as a whole number from 0 to 86400."
msgstr "最短播放時間，須為 0 至 86400 的整數。"

#. type: TP
#: amulecmd.1.in
#, no-wrap
msgid "B<--codec>, B<--title>, B<--album>, B<--artist> I<E<lt>textE<gt>>"
msgstr "B<--codec>, B<--title>, B<--album>, B<--artist> I<E<lt>文字E<gt>>"

#. type: Plain text
#: amulecmd.1.in
msgid "Each option takes a text value. Enclose values containing spaces in single or double quotes.  When using B<-c>, preserve those quotes inside the command string passed by the shell."
msgstr "每個選項都接受一個文字值。值含有空格時，請用單引號或雙引號括起來。使用 B<-c> 時，請確保這些引號保留在 Shell 傳入的指令字串中。"

#. type: Plain text
#: amulecmd.1.in
msgid "Zero or empty media values impose no constraint. Nonempty media filters require daemon support. Kad applies these filters; eD2k servers may ignore them."
msgstr "媒體條件設為零或留空時不會限制結果。指定其他值時，背景服務必須支援媒體篩選。Kad 會套用這些條件，eD2k 伺服器可能會忽略它們。"

#. type: Plain text
#: amulecmd.1.in
msgid "Example: 'search global linux iso --type Iso --min-size 100M' returns results for 'linux iso' of file-type Iso at least 100 MiB."
msgstr "例如，'search global linux iso --type Iso --min-size 100M' 會搜尋 'linux iso'，並只傳回類型為 Iso、大小至少為 100 MiB 的檔案。"

#. type: Plain text
#: amulecmd.1.in
msgid "Sets a given preferences value."
msgstr "設定指定的偏好設定值。"

#. type: Plain text
#: amulecmd.1.in
msgid "Set bandwidth limits."
msgstr "設定頻寬限制。"

#. type: Plain text
#: amulecmd.1.in
msgid "Set IPFilter preferences."
msgstr "設定 IP 過濾器的偏好設定。"

#. type: Plain text
#: amulecmd.1.in
msgid "Shows upload/download queue, servers list or shared files list."
msgstr "顯示上傳與下載佇列、伺服器清單或分享檔案清單。"

#. type: Plain text
#: amulecmd.1.in
msgid "Show download queue."
msgstr "顯示下載佇列。"

#. type: Plain text
#: amulecmd.1.in
msgid "Show log."
msgstr "顯示日誌。"

#. type: Plain text
#: amulecmd.1.in
msgid "Show servers list."
msgstr "顯示伺服器清單。"

#. type: Plain text
#: amulecmd.1.in
msgid "Show shared files list."
msgstr "顯示分享檔案清單。"

#. type: Plain text
#: amulecmd.1.in
msgid "Show upload queue."
msgstr "顯示上傳佇列。"

#. type: Plain text
#: amulecmd.1.in
msgid "Shutdown the remote running core (amule/amuled).  This will also shut down the text client, since it is unusable without a running core."
msgstr "關閉在遠端執行的核心程式（amule/amuled）。文字介面用戶端也會一併結束，因為它需要核心程式才能運作。"

#. type: Plain text
#: amulecmd.1.in
msgid "Show statistics tree."
msgstr "以樹狀結構顯示統計資訊。"

#. type: Plain text
#: amulecmd.1.in
msgid "The optional I<E<lt>numberE<gt>> in the range of 0-255 can be passed as argument to this command, which tells how many entries of the client version subtree should be shown. Passing 0, or omitting it means 'unlimited'."
msgstr "這個指令可接受 0 到 255 的選填參數 I<E<lt>數量E<gt>>，用來限制統計樹中各類用戶端顯示的版本數量。輸入 0 或省略參數表示不限。"

#. type: Plain text
#: amulecmd.1.in
msgid "Example: 'statistics 5' will show only the top 5 versions for each client type."
msgstr "例如，'statistics 5' 只會列出每類用戶端排名前 5 的版本。"

#. type: Plain text
#: amulecmd.1.in
msgid "Show connection status, current up/download speeds, etc."
msgstr "顯示連線狀態、目前的上傳與下載速度等資訊。"

#. type: SS
#: amulecmd.1.in
#, no-wrap
msgid "Languages"
msgstr "語言"

#. type: Plain text
#: amulecmd.1.in
msgid "The I<E<lt>langE<gt>> parameter for the B<-l> option has the following form: I<lang>[B<_>I<LANG>][B<.>I<encoding>][B<@>I<modifier>] where I<lang> is the primary language, I<LANG> is a sublanguage/territory, I<encoding> is the character set to use and I<modifier> allows the user to select a specific instance of localization data within a single category."
msgstr "B<-l> 選項的 I<E<lt>語言E<gt>> 參數格式為 I<lang>[B<_>I<LANG>][B<.>I<encoding>][B<@>I<modifier>]。I<lang> 是主要語言代碼，I<LANG> 是次語言或地區代碼，I<encoding> 指定字元集，I<modifier> 可選擇同一類別中的特定一組語系資料。"

#. type: Plain text
#: amulecmd.1.in
msgid "For example, the following strings are valid:"
msgstr "例如，以下的字串都有效："

#. type: Plain text
#: amulecmd.1.in
msgid "Though all the above strings are accepted as valid language definitions, I<encoding> and I<modifier> are yet unused."
msgstr "以上字串都是有效的語系設定，但目前程式還不會使用 I<encoding> 和 I<modifier>。"

#. type: Plain text
#: amulecmd.1.in
msgid "In addition to the format above, you can also specify full language names in English - so B<-l german> is also valid and is equal to B<-l de_DE>."
msgstr "除了上述格式，也可以使用語言的完整英文名稱。B<-l german> 是有效的寫法，效果和 B<-l de_DE> 相同。"

#. type: Plain text
#: amulecmd.1.in
msgid "When no locale is defined, either on command-line or in config file, system default language will be used."
msgstr "沒有在命令列或設定檔中設定語系時，會使用系統預設語言。"

#. type: Plain text
#: amulecmd.1.in
msgid "~/.aMule/remote.conf"
msgstr "~/.aMule/remote.conf"

#. type: Plain text
#: amulecmd.1.in
msgid "The password is saved as an MD5 digest in [EC]/PasswordMD5, the same key as in amuleapi.conf. An [EC]/Password key from an older file is moved there on load."
msgstr "密碼會以 MD5 雜湊值儲存在 [EC]/PasswordMD5，和 amuleapi.conf 使用的設定鍵相同。舊設定檔的 [EC]/Password 會在載入時移到這個鍵。"

#. type: SH
#: amulecmd.1.in
#, no-wrap
msgid "EXAMPLE"
msgstr "範例"

#. type: Plain text
#: amulecmd.1.in
msgid "Typically amulecmd will be first run as:"
msgstr "第一次執行 amulecmd 時，通常會這樣輸入："

#. type: Plain text
#: amulecmd.1.in
msgid "B<amulecmd> B<-h> I<hostname> B<-p> I<ECport> B<--password-stdin> B<-w>"
msgstr "B<amulecmd> B<-h> I<hostname> B<-p> I<ECport> B<--password-stdin> B<-w>"

#. type: Plain text
#: amulecmd.1.in
msgid "This will save settings to I<$HOME/.aMule/remote.conf>, and later you only need to type:"
msgstr "這會把設定儲存到 I<$HOME/.aMule/remote.conf>。之後只要輸入："

#. type: Plain text
#: amulecmd.1.in
msgid "Of course, you don't have to follow this example."
msgstr "當然，你可以不必都遵照這個範例。"

#. type: TH
#: amuled.1.in
#, no-wrap
msgid "AMULED"
msgstr "AMULED"

#. type: TH
#: amuled.1.in
#, no-wrap
msgid "aMule Daemon v@PACKAGE_VERSION@"
msgstr "aMule 背景服務 v@PACKAGE_VERSION@"

#. type: TH
#: amuled.1.in
#, no-wrap
msgid "aMule Daemon"
msgstr "aMule 背景服務"

#. type: Plain text
#: amuled.1.in
msgid "amuled - the all-platform eMule p2p client - daemonized version"
msgstr "amuled - 跨平台 eMule P2P 用戶端的背景服務版"

#. type: Plain text
#: amuled.1.in ../../src/utils/cas/docs/cas.1.in
msgid "[B<-c> I<E<lt>pathE<gt>>]"
msgstr "[B<-c> I<E<lt>路徑E<gt>>]"

#. type: Plain text
#: amuled.1.in
msgid "[B<-p> I<E<lt>pathE<gt>>]"
msgstr "[B<-p> I<E<lt>路徑E<gt>>]"

#. type: Plain text
#: amuled.1.in
msgid "Forks to background."
msgstr "建立子行程並在背景執行。"

#. type: TP
#: amuled.1.in
#, no-wrap
msgid "B<[ -p> I<E<lt>pathE<gt>>, B<--pid-file>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ -p> I<E<lt>路徑E<gt>>, B<--pid-file>=I<E<lt>路徑E<gt>> B<]>"

#. type: Plain text
#: amuled.1.in
msgid "After fork, create a pid-file in the I<E<lt>pathE<gt>>.  I<E<lt>pathE<gt>> has to contain the filename."
msgstr "建立子行程後，會在 I<E<lt>路徑E<gt>> 指定的位置建立 PID 檔案。I<E<lt>路徑E<gt>> 必須包含檔名。"

#. type: Plain text
#: amuled.1.in
msgid "Set the External Connections password, enable External Connections, then exit without starting the core. Terminal input is hidden and confirmed; redirected stdin supplies one line without confirmation. An empty password is rejected.  Refused while aMule or another amuled uses the same config dir."
msgstr "設定外部連線密碼並啟用外部連線，接著結束程式，核心程式不會啟動。從終端機輸入時，密碼不會顯示，且必須再輸入一次確認。若重新導向標準輸入，只讀取一行，無須確認。密碼不可留空。若 aMule 或另一個 amuled 正在使用同一個設定目錄，程式會拒絕這項操作。"

#. type: Plain text
#: amuled.1.in
msgid "Enable or disable starting amuled on user login, then exit.  The OS-specific store is selected automatically: Windows registry Run key, macOS LaunchAgent, Linux XDG I<.desktop> autostart entry."
msgstr "啟用或停用使用者登入時自動啟動 amuled，然後結束程式。程式會依作業系統自動選用設定位置：Windows 使用 Registry 的 Run 機碼，macOS 使用 LaunchAgent，Linux 使用 XDG 的 I<.desktop> 自動啟動項目。"

#. type: TP
#: amuled.1.in
#, no-wrap
msgid "B<[ -t> I<E<lt>numE<gt>>, B<--category>=I<E<lt>numE<gt>> B<]>"
msgstr "B<[ -t> I<E<lt>分類編號E<gt>>, B<--category>=I<E<lt>分類編號E<gt>> B<]>"

#. type: TP
#: amuled.1.in
#, no-wrap
msgid "I<~/.aMule/allowed-remote-dirs.dat>"
msgstr "I<~/.aMule/allowed-remote-dirs.dat>"

#. type: Plain text
#: amuled.1.in
msgid "The folders a remote EC or amuleapi client may point the incoming, temporary, shared or category download folders at, one absolute path per line. Empty or absent (the default) means every such remote folder change is refused. On a daemon-only install, such as a container or the Android port with no monolithic aMule to edit the list in its GUI, create or edit this file and restart B<amuled> to allow remote folder changes; relative lines are ignored."
msgstr "列出遠端 EC 或 amuleapi 用戶端可指定的資料夾，用於存放已下載檔案、暫存檔、分享檔案或各分類的下載內容。每行填一個絕對路徑。檔案留空或不存在時（預設情況），所有這類遠端變更都會被拒絕。如果只安裝背景服務，例如在容器或 Android 版環境中，沒有整合版 aMule 的圖形介面可編輯清單，請建立或編輯此檔案，再重新啟動 B<amuled>，即可允許遠端變更資料夾。相對路徑會被忽略。"

#. type: SH
#: amuled.1.in
#, no-wrap
msgid "MEDIA METADATA"
msgstr "媒體中繼資料"

#. type: Plain text
#: amuled.1.in
msgid "B<amuled> runs its bundled B<amule-media-probe> helper on each received file to extract the length, bitrate and codec tags it then publishes to the network. The helper must sit next to the B<amuled> executable. This is on by default (B<Enabled=1> under B<[MediaMetadata]> in I<amule.conf>); set B<Enabled=0> there and restart to turn it off."
msgstr "B<amuled> 會對每個接收的檔案執行隨附的 B<amule-media-probe>，擷取播放時間、位元速率和編解碼器資訊，再將這些資料發布到網路。這個輔助程式必須與 B<amuled> 執行檔放在同一個目錄。功能預設啟用（I<amule.conf> 的 B<[MediaMetadata]> 區段設為 B<Enabled=1>）。若要停用，請將該區段設為 B<Enabled=0> 並重新啟動。"

#. type: TH
#: amulegui.1.in
#, no-wrap
msgid "AMULEGUI"
msgstr "AMULEGUI"

#. type: TH
#: amulegui.1.in
#, no-wrap
msgid "aMuleGUI v@PACKAGE_VERSION@"
msgstr "aMuleGUI v@PACKAGE_VERSION@"

#. type: TH
#: amulegui.1.in
#, no-wrap
msgid "aMuleGUI"
msgstr "aMuleGUI"

#. type: Plain text
#: amulegui.1.in
msgid "amulegui - aMule control program with GUI"
msgstr "amulegui - 圖形介面的 aMule 控制程式"

#. type: Plain text
#: amulegui.1.in
msgid "B<amulegui> is a client program, and can be connected to amule or amuled via EC. You can manage your amule program with it. It provides almost the same functionalities as amule, even if the core works on another computer."
msgstr "B<amulegui> 是透過外部連線（EC）管理 amule 或 amuled 的用戶端。即使核心程式在另一台電腦上執行，它也能提供和 amule 幾乎相同的功能。"

#. type: Plain text
#: amulegui.1.in
msgid "Write logs to the specified filename instead of the default log file.  Overrides the B<LogFilePath> setting under B<[eMule]> in I<remote.conf> for this run only.  Relative paths are resolved against the configuration directory.  The parent directory must already exist and be writable; it is not created automatically.  An empty or absent configuration setting uses I<remotelogfile> in the configuration directory.  On startup, the previous log is backed up to the same path with I<.bak> appended.  If the backup cannot be created, a warning is logged and the current session is appended to the existing log.  Configuration changes take effect after restart."
msgstr "將日誌寫入指定檔案。這個選項只在本次執行期間覆寫 I<remote.conf> 的 B<[eMule]> 區段中 B<LogFilePath> 的設定。相對路徑以設定目錄為基準。上層目錄必須已存在且可寫入，程式不會自動建立。設定留空或未設定時，會使用設定目錄下的 I<remotelogfile>。啟動時會備份上一份日誌，沿用原路徑並在末尾加上 I<.bak>。若無法建立備份，程式會記下警告，並將本次執行的日誌附加到現有檔案。變更設定後須重新啟動才會生效。"

#. type: Plain text
#: amulegui.1.in
msgid "Skip connection dialog."
msgstr "跳過連線對話方塊。"

#. type: Plain text
#: amulegui.1.in
msgid "Enable or disable starting amulegui on user login, then exit.  The OS-specific store is selected automatically: Windows registry Run key, macOS LaunchAgent, Linux XDG I<.desktop> autostart entry."
msgstr "啟用或停用使用者登入時自動啟動 amulegui，然後結束程式。程式會依作業系統自動選用設定位置：Windows 使用 Registry 的 Run 機碼，macOS 使用 LaunchAgent，Linux 使用 XDG 的 I<.desktop> 自動啟動項目。"

#. type: Plain text
#: amulegui.1.in
msgid "Sends an eD2k-link, or every link in an eMule collection file, to the connected core."
msgstr "將單一 eD2k 連結或 eMule 集合檔中的所有連結傳給已連線的核心程式。"

#. type: TP
#: amulegui.1.in
#, no-wrap
msgid "I<~/.aMule/remote.conf>"
msgstr "I<~/.aMule/remote.conf>"

#. type: Plain text
#: amulegui.1.in
msgid "Settings, including the core to connect to."
msgstr "設定檔，包含要連線的核心程式資訊。"

#. type: TP
#: amulegui.1.in
#, no-wrap
msgid "I<~/.aMule/remotelogfile>"
msgstr "I<~/.aMule/remotelogfile>"

#. type: Plain text
#: amulegui.1.in
msgid "The log."
msgstr "日誌檔。"

#. type: TP
#: amulegui.1.in
#, no-wrap
msgid "I<~/.aMule/ED2KLinks>"
msgstr "I<~/.aMule/ED2KLinks>"

#. type: Plain text
#: amulegui.1.in
msgid "Links passed on the command line, waiting to be sent to the core."
msgstr "從命令列傳入、等待送往核心程式的連結。"

#. type: Plain text
#: amulegui.1.in
msgid "This manpage was written by Julien Delange for Debian E<lt>julien AT gunnm DOT orgE<gt>"
msgstr "本手冊頁由 Julien Delange 為 Debian 撰寫 E<lt>julien AT gunnm DOT orgE<gt>"

#. type: Plain text
#: amulegui.1.in
msgid "This manpage was rewritten by Vollstrecker E<lt>amule@vollstreckernet.deE<gt>"
msgstr "本手冊頁由 Vollstrecker E<lt>amule@vollstreckernet.deE<gt> 改寫"

#. type: TH
#: ed2k.1.in
#, no-wrap
msgid "ED2K"
msgstr "ED2K"

#. type: TH
#: ed2k.1.in
#, no-wrap
msgid "aMule eD2k link parser v1.5.1"
msgstr "aMule 的 eD2k 連結分析程式 v1.5.1"

#. type: Plain text
#: ed2k.1.in
msgid "ed2k - aMule eD2k link parser"
msgstr "ed2k - aMule 的 eD2k 連結分析程式"

#. type: Plain text
#: ed2k.1.in
msgid "[B<-c> I<E<lt>pathE<gt>>] [B<-t> I<E<lt>numE<gt>>]"
msgstr "[B<-c> I<E<lt>路徑E<gt>>] [B<-t> I<E<lt>分類編號E<gt>>]"

#. type: Plain text
#: ed2k.1.in
msgid "I<E<lt>eD2k-linkE<gt>>"
msgstr "I<E<lt>eD2k 連結E<gt>>"

#. type: Plain text
#: ed2k.1.in
msgid "Sends the given I<E<lt>eD2k-linkE<gt>> to aMule, i.e. writes it to the file ~/.aMule/ED2KLinks, which will be checked by aMule every second for links."
msgstr "將指定的 I<E<lt>eD2k 連結E<gt>> 寫入 ~/.aMule/ED2KLinks 檔案。aMule 每秒會檢查一次這個檔案，看看是否有新連結。"

#. type: TP
#: ed2k.1.in
#, no-wrap
msgid "B<[ -t> I<E<lt>numE<gt>>, B<--category> I<E<lt>numE<gt>> B<]>"
msgstr "B<[ -t> I<E<lt>分類編號E<gt>>, B<--category> I<E<lt>分類編號E<gt>> B<]>"

#. type: Plain text
#: ed2k.1.in
msgid "Set category for passed eD2k links to I<E<lt>numE<gt>>.  Unlike B<--config-dir>, the parser reads the value as the next argument and does not accept B<--category>=I<E<lt>numE<gt>> syntax."
msgstr "將傳入的 eD2k 連結歸到 I<E<lt>分類編號E<gt>> 指定的分類。B<--config-dir> 可以用等號指定值，但這個選項只會讀取下一個引數，因此不接受 B<--category>=I<E<lt>分類編號E<gt>> 的寫法。"

#. type: Plain text
#: ed2k.1.in
msgid "Loads all links found in the emulecollection given as I<E<lt>ed2k-linkE<gt>>"
msgstr "載入以 I<E<lt>eD2k 連結E<gt>> 引數指定的 eMule 集合檔中的所有連結"

#. type: Plain text
#: ed2k.1.in
msgid "Lists all links found in the emulecollection given as I<E<lt>ed2k-linkE<gt>>"
msgstr "列出以 I<E<lt>eD2k 連結E<gt>> 引數指定的 eMule 集合檔中的所有連結"

#. type: TP
#: ed2k.1.in
#, no-wrap
msgid "B<[ eD2k-link ]>"
msgstr "B<[ eD2k 連結 ]>"

#. type: Plain text
#: ed2k.1.in
msgid "Adds an eD2k-link to the core."
msgstr "將 eD2k 連結加入核心程式。"

#. type: Plain text
#: ed2k.1.in
msgid "a magnet link;"
msgstr "magnet 連結；"

#. type: Plain text
#: ed2k.1.in
msgid "an emulecollection file."
msgstr "eMule 集合檔。"

#. type: Plain text
#: ed2k.1.in
msgid "B<The order in which you give the parameters is important.> You can give more than one link, and every link can have it's own params.  For example B<ed2k E<lt>link1E<gt> -t2 E<lt>link2E<gt>> will download I<E<lt>link1E<gt>> in standard category and I<E<lt>link2E<gt>> in category 2."
msgstr "B<參數的順序會影響結果。> 可以指定多個連結，並分別為各連結指定參數。例如，B<ed2k E<lt>link1E<gt> -t 2 E<lt>link2E<gt>> 會將 I<E<lt>link1E<gt>> 加到預設分類下載，將 I<E<lt>link2E<gt>> 加到分類 2 下載。"

#. type: Plain text
#: ed2k.1.in
msgid "~/.aMule/ED2KLinks"
msgstr "~/.aMule/ED2KLinks"

#. type: TH
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#, no-wrap
msgid "ALC"
msgstr "ALC"

#. type: TH
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#, no-wrap
msgid "aLinkCreator"
msgstr "aLinkCreator"

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alc.1.in
msgid "aLinkCreator - the aMule eD2k link creator"
msgstr "aLinkCreator - aMule 的 eD2k 連結建立程式"

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alc.1.in
msgid "B<alc> is a graphical utility to create an eD2k link to any file on your computer."
msgstr "B<alc> 是圖形介面工具，可以為電腦上的任何檔案建立 eD2k 連結。"

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/wxCas/docs/wxcas.1.in
msgid "This app doesn't take any arguments."
msgstr "這個應用程式不接受任何引數。"

#. type: TH
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#, no-wrap
msgid "ALCC"
msgstr "ALCC"

#. type: TH
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#, no-wrap
msgid "aMule eD2k links calculator"
msgstr "aMule 的 eD2k 連結計算程式"

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
msgid "alcc - text based eD2k links calculator for aMule"
msgstr "alcc - aMule 的文字介面 eD2k 連結計算程式"

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
msgid "I<E<lt>inputfiles_listE<gt>>"
msgstr "I<E<lt>輸入檔案清單E<gt>>"

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
msgid "Compute the eD2k links of all the input files given in the I<E<lt>inputfiles_listE<gt>> (There can be one or more files)."
msgstr "為 I<E<lt>輸入檔案清單E<gt>> 中的每個檔案計算 eD2k 連結。清單可以包含一個或多個檔案。"

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
msgid "Compute and add part hashes to the computed eD2k links."
msgstr "計算各檔案分段的雜湊值，並將這些值加入算出的 eD2k 連結。"

#. type: Plain text
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
msgid "Be verbose - show also calculation steps."
msgstr "顯示詳細資訊，包括計算步驟。"

#. type: TH
#: ../../src/utils/cas/docs/cas.1.in
#, no-wrap
msgid "CAS"
msgstr "CAS"

#. type: TH
#: ../../src/utils/cas/docs/cas.1.in
#, no-wrap
msgid "cas v0.8"
msgstr "cas v0.8"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "cas - c aMule statistics"
msgstr "cas - 以 C 語言撰寫的 aMule 統計資訊程式"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "B<cas> is a program for displaying the contents of your aMule online signature file to console (in a human readable form). For this to work, you must enable the \"Online Signature\" option in aMule's preferences."
msgstr "B<cas> 會在終端機以容易閱讀的格式顯示 aMule 線上簽名檔的內容。使用前請在 aMule 的偏好設定中啟用「線上簽名」。"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "Writes the online signature picture.  The long form B<--picture> accepts an optional I<=E<lt>PATHE<gt>> to specify the output location; the short forms B<-o> / B<-P> do not (B<-P> requires an immediately following I<E<lt>PATHE<gt>> argument, and B<-o> is a no-argument switch).  Requires GD support compiled in (I<__GD__>); this option is silently ignored otherwise."
msgstr "輸出線上簽名圖片。長選項 B<--picture> 可以加上 I<=E<lt>路徑E<gt>> 指定輸出位置。短選項 B<-o> 和 B<-P> 採用不同語法：B<-P> 後面必須緊接一個 I<E<lt>路徑E<gt>> 引數，B<-o> 則不接受引數。程式必須在編譯時啟用 GD 支援（I<__GD__>），否則會直接略過此選項。"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "HTML page with stats and picture.  The long form B<--html> accepts an optional I<=E<lt>PATHE<gt>> to specify the output location; the short forms B<-p> / B<-H> do not (B<-H> requires an immediately following I<E<lt>PATHE<gt>> argument, and B<-p> is a no-argument switch)."
msgstr "輸出包含統計資訊和圖片的 HTML 網頁。長選項 B<--html> 可以加上 I<=E<lt>路徑E<gt>> 指定輸出位置。短選項 B<-p> 和 B<-H> 採用不同語法：B<-H> 後面必須緊接一個 I<E<lt>路徑E<gt>> 引數，B<-p> 則不接受引數。"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "Without any options, it prints online signature data to stdout."
msgstr "未指定選項時，會將線上簽名資料寫到標準輸出。"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "B<cas> was written by Pedro de Oliveira E<lt>falso@rdk.homeip.netE<gt>"
msgstr "B<cas> 由 Pedro de Oliveira E<lt>falso@rdk.homeip.netE<gt> 撰寫"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "~/.aMule/casrc"
msgstr "~/.aMule/casrc"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "aMule-online-sign.png (or .jpg, when B<-o> / B<--picture> is used and GD is available)"
msgstr "aMule-online-sign.png（或 .jpg，使用 B<-o> 或 B<--picture> 且支援 GD 時產生）"

#. type: Plain text
#: ../../src/utils/cas/docs/cas.1.in
msgid "aMule-online-sign.html (when B<-p> / B<--html> is used)"
msgstr "aMule-online-sign.html（使用 B<-p> 或 B<--html> 時產生）"

#. type: TH
#: ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "WXCAS"
msgstr "WXCAS"

#. type: TH
#: ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "wxCas"
msgstr "wxCas"

#. type: Plain text
#: ../../src/utils/wxCas/docs/wxcas.1.in
msgid "wxcas - wx c aMule statistics"
msgstr "wxcas - 以 C 語言、wxWidgets 撰寫的 aMule 統計資訊程式"

#. type: Plain text
#: ../../src/utils/wxCas/docs/wxcas.1.in
msgid "B<wxcas> is a program for displaying the contents of your online signature file in a nice wx Window on your Desktop.  For this to work, you must enable the \"Online Signature\" option in aMule's preferences."
msgstr "B<wxcas> 會在桌面的 wxWidgets 視窗中顯示線上簽名檔的內容。使用前請在 aMule 的偏好設定中啟用「線上簽名」。"

#. type: Plain text
#: ../../src/utils/wxCas/docs/wxcas.1.in
msgid "Based on Pedro de Oliveira's B<cas>(1).  B<wxcas> was written by ThePolish E<lt>thepolish@vipmail.ruE<gt>"
msgstr "以 Pedro de Oliveira 的 B<cas>(1) 為基礎。B<wxcas> 由 ThePolish E<lt>thepolish@vipmail.ruE<gt> 撰寫"

#~ msgid "[B<-h> I<E<lt>hostE<gt>>] [B<-p> I<E<lt>portE<gt>>] [B<-P> I<E<lt>passwordE<gt>>] [B<-f> I<E<lt>pathE<gt>>]"
#~ msgstr "[B<-h> I<E<lt>主機E<gt>>] [B<-p> I<E<lt>通訊埠E<gt>>] [B<-P> I<E<lt>密碼E<gt>>] [B<-f> I<E<lt>路徑E<gt>>]"

#~ msgid "[B<--create-config-from>=I<E<lt>pathE<gt>>]"
#~ msgstr "[B<--create-config-from>=I<E<lt>路徑E<gt>>]"

