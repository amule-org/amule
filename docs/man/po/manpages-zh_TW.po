#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "NAME"
msgstr "名稱"

#. type: Plain text
#: amule.1.in
msgid "amule - the all-platform eMule p2p client"
msgstr "amule - 跨平台的 eMule P2P 用戶端"

#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "SYNOPSIS"
msgstr "用法"

#. type: Plain text
#: amule.1.in amulegui.1.in
msgid "[B<-c> I<E<lt>pathE<gt>>] [B<-geometry> I<E<lt>geomE<gt>>]"
msgstr "[B<-c> I<E<lt>路徑E<gt>>] [B<-geometry> I<E<lt>大小與位置E<gt>>]"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "[B<-t> I<E<lt>numE<gt>>] [I<eD2k-link>|I<collection-file>]"
msgstr "[B<-t> I<E<lt>分類編號E<gt>>] [I<eD2k 連結>|I<集合檔>]"

#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "DESCRIPTION"
msgstr "說明"

#. type: TP
#: amule.1.in amuled.1.in amulegui.1.in ed2k.1.in
#: ../../src/utils/cas/docs/cas.1.in
#, no-wrap
msgid "B<[ -c> I<E<lt>pathE<gt>>, B<--config-dir>=I<E<lt>pathE<gt>> B<]>"
msgstr "B<[ -c> I<E<lt>路徑E<gt>>, B<--config-dir>=I<E<lt>路徑E<gt>> B<]>"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in ed2k.1.in
#: ../../src/utils/cas/docs/cas.1.in
msgid "Read config from I<E<lt>pathE<gt>> instead of home"
msgstr "改從 I<E<lt>路徑E<gt>> 讀取設定（預設位置在家目錄）"

#. type: TP
#: amule.1.in amuled.1.in amulegui.1.in
#, no-wrap
msgid "B<[ --log-file>=I<E<lt>fileE<gt>> B<]>"
msgstr "B<[ --log-file>=I<E<lt>檔名E<gt>> B<]>"

#. type: Plain text
#: amule.1.in amuled.1.in
msgid "Write logs to the specified filename instead of the default log file.  Overrides the B<LogFilePath> setting under B<[eMule]> in I<amule.conf> for this run only.  Relative paths are resolved against the configuration directory.  The parent directory must already exist and be writable; it is not created automatically.  An empty or absent configuration setting uses I<logfile> in the configuration directory.  On startup, the previous log is backed up to the same path with I<.bak> appended.  If the backup cannot be created, a warning is logged and the current session is appended to the existing log.  Configuration changes take effect after restart."
msgstr "將日誌寫入指定檔案。這個選項只在本次執行期間覆寫 I<amule.conf> 的 B<[eMule]> 區段中 B<LogFilePath> 的設定。相對路徑以設定目錄為基準。上層目錄必須已存在且可寫入，程式不會自動建立。設定留空或未設定時，會使用設定目錄下的 I<logfile>。啟動時會備份上一份日誌，沿用原路徑並在末尾加上 I<.bak>。若無法建立備份，程式會記下警告，並將本次執行的日誌附加到現有檔案。變更設定後須重新啟動才會生效。"

#. type: TP
#: amule.1.in amulegui.1.in
#, no-wrap
msgid "B<[ -geometry >I<E<lt>geomE<gt>> B<]>"
msgstr "B<[ -geometry >I<E<lt>大小與位置E<gt>> B<]>"

#. type: Plain text
#: amule.1.in amulegui.1.in
msgid "Sets the geometry of the app. I<E<lt>geomE<gt>> uses the same format as standard X11 apps:\t[B<=>][I<E<lt>widthE<gt>>{B<xX>}I<E<lt>heightE<gt>>][{B<+->}I<E<lt>xoffsetE<gt>>{B<+->}I<E<lt>yoffsetE<gt>>]"
msgstr "設定應用程式視窗的大小與位置。I<E<lt>大小與位置E<gt>> 的格式和一般 X11 應用程式相同：\t[B<=>][I<E<lt>寬度E<gt>>{B<xX>}I<E<lt>高度E<gt>>][{B<+->}I<E<lt>X 軸位移E<gt>>{B<+->}I<E<lt>Y 軸位移E<gt>>]"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Prints log messages to stdout."
msgstr "將日誌訊息寫到標準輸出。"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Resets config to default values."
msgstr "將設定重設為預設值。"

#. type: Plain text
#: amule.1.in
msgid "Enable or disable starting aMule on user login, then exit.  The OS-specific store is selected automatically: Windows registry Run key, macOS LaunchAgent, Linux XDG I<.desktop> autostart entry."
msgstr "啟用或停用使用者登入時自動啟動 aMule，然後結束程式。程式會依作業系統自動選用設定位置：Windows 使用 Registry 的 Run 機碼，macOS 使用 LaunchAgent，Linux 使用 XDG 的 I<.desktop> 自動啟動項目。"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Enable or disable aMule as the current user's default handler for ed2k:// and magnet: links, then exit.  I<E<lt>valueE<gt>> is B<on> or B<off> for both kinds of link, or B<ed2k:on>, B<ed2k:off>, B<magnet:on> or B<magnet:off> for one of them.  The OS-specific store is selected automatically: Windows registry, macOS LaunchServices, Linux XDG I<mimeapps.list>."
msgstr "將 aMule 設為目前使用者開啟 ed2k:// 和 magnet: 連結的預設程式，或取消這項設定，然後結束程式。I<E<lt>值E<gt>> 可用 B<on> 或 B<off> 一次設定兩種連結，也可用 B<ed2k:on>、B<ed2k:off>、B<magnet:on> 或 B<magnet:off> 個別設定。程式會依作業系統自動選用設定位置：Windows 使用 Registry，macOS 使用 LaunchServices，Linux 使用 XDG 的 I<mimeapps.list>。"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Enable or disable aMule as the current user's handler for I<.emulecollection> files, then exit.  The OS-specific store is selected automatically: Windows registry, macOS LaunchServices, Linux XDG I<mimeapps.list>."
msgstr "設定或取消由 aMule 為目前使用者開啟 I<.emulecollection> 檔案，然後結束程式。程式會依作業系統自動選用設定位置：Windows 使用 Registry，macOS 使用 LaunchServices，Linux 使用 XDG 的 I<mimeapps.list>。"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Don't catch fatal exceptions and don't block exit on assertions.  Useful for headless / supervised setups (systemd, watchdog scripts)  where the otherwise-modal assertion dialog prevents auto-restart."
msgstr "不攔截致命例外，也不因斷言失敗而阻止程式結束。這適用於無圖形介面或由其他程式監控的執行環境（例如 systemd 或看門狗指令碼），避免斷言對話方塊等待回應而使程式無法自動重新啟動。"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Does not disable stdin."
msgstr "不停用標準輸入。"

#. type: TP
#: amule.1.in amulegui.1.in
#, no-wrap
msgid "B<[ -t>, B<--category>=I<E<lt>numE<gt>> B<]>"
msgstr "B<[ -t>, B<--category>=I<E<lt>分類編號E<gt>> B<]>"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Set category for passed eD2k links to I<E<lt>numE<gt>>"
msgstr "將傳入的 eD2k 連結歸到 I<E<lt>分類編號E<gt>> 指定的分類"

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in ed2k.1.in
msgid "Displays the current version number."
msgstr "顯示目前的版本號碼。"

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in
msgid "Prints a short usage description."
msgstr "顯示簡短的使用說明。"

#. type: TP
#: amule.1.in amuled.1.in amulegui.1.in
#, no-wrap
msgid "B<[ eD2k-link | collection-file ]>"
msgstr "B<[ eD2k 連結 | 集合檔 ]>"

#. type: Plain text
#: amule.1.in amuled.1.in
msgid "Adds an eD2k-link, or every link in an eMule collection file, to the core."
msgstr "將單一 eD2k 連結或 eMule 集合檔中的所有連結加入核心程式。"

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in ed2k.1.in
msgid "The eD2k link to be added can be:"
msgstr "可以使用以下幾種 eD2k 連結："

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in ed2k.1.in
msgid "a file link (ed2k://|file|...), it will be added to the download queue;"
msgstr "檔案連結（ed2k://|file|...），會將檔案加入下載佇列；"

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in ed2k.1.in
msgid "a server link (ed2k://|server|...), it will be added to the server list;"
msgstr "伺服器連結（ed2k://|server|...），會將該伺服器加入伺服器清單；"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in ed2k.1.in
msgid "a serverlist link, in which case all servers in the list will be added to the server list;"
msgstr "伺服器清單連結，會一次加入清單中的所有伺服器；"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "a magnet link."
msgstr "magnet 連結。"

#. type: Plain text
#: amule.1.in amuled.1.in amulegui.1.in
msgid "Alternatively the argument can be the path to an .emulecollection file, or a file:// URL naming one, in which case every link it contains is added to the download queue.  This is what lets a file manager open a collection with aMule."
msgstr "也可以傳入 .emulecollection 檔案的路徑，或指向該檔案的 file:// 網址。檔案內的所有連結都會加入下載佇列。檔案管理員就是透過這個方式用 aMule 開啟集合檔。"

#. type: SH
#: amule.1.in amulecmd.1.in amulegui.1.in
#, no-wrap
msgid "NOTES"
msgstr "附註"

#. type: SS
#: amule.1.in amulecmd.1.in amulegui.1.in
#, no-wrap
msgid "Paths"
msgstr "路徑"

#. type: Plain text
#: amule.1.in amulecmd.1.in amulegui.1.in
msgid "For all options which take a I<E<lt>pathE<gt>> value, if the I<path> contains no directory part (i.e. just a plain filename), then it is considered to be under the aMule configuration directory, I<~/.aMule>."
msgstr "若選項的 I<E<lt>路徑E<gt>> 只含檔名（I<路徑> 中沒有目錄），aMule 會從設定目錄 I<~/.aMule> 下尋找該檔案。"

#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in ed2k.1.in
#: ../../src/utils/cas/docs/cas.1.in
#, no-wrap
msgid "FILES"
msgstr "檔案"

#. type: Plain text
#: amule.1.in amuled.1.in
msgid "~/.aMule/*"
msgstr "~/.aMule/*"

#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
msgid "REPORTING BUGS"
msgstr "回報問題"

#. type: Plain text
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
msgid "Please report bugs either on our forum (I<https://github.com/amule-org/amule/discussions>), or in our bugtracker (I<https://github.com/amule-org/amule/issues>).  Please do not report bugs in e-mail, neither to our mailing list nor directly to any team member."
msgstr "請到我們的論壇（I<https://github.com/amule-org/amule/discussions>）或問題追蹤系統（I<https://github.com/amule-org/amule/issues>）回報程式錯誤。請勿透過電子郵件回報，包括寄到郵件清單或直接寄給團隊成員。"

#. type: SH
#: amule.1.in amulecmd.1.in amuled.1.in amulegui.1.in ed2k.1.in
#: ../../src/utils/aLinkCreator/docs/alc.1.in
#: ../../src/utils/aLinkCreator/docs/alcc.1.in
#: ../../src/utils/cas/docs/cas.1.in ../../src/utils/wxCas/docs/wxcas.1.in
#, no-wrap
