<?xml version="1.0" encoding="UTF-8"?>
<!--
  shared-mime-info package for eMule collection files.

  Glob only, deliberately. A binary collection opens with a four-byte
  little-endian version of 1 or 2, which is far too common a prefix to use
  as magic: any <match> on it would steal detection from unrelated binary
  files across the whole system. The text form is a list of ed2k:// URIs,
  which is likewise indistinguishable from a plain text file of links.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-emule-collection">
    <comment>eMule collection</comment>
    <glob pattern="*.emulecollection"/>
    <!--
      Fallback for the file-type icon. The icon we install as
      application-x-emule-collection.png is preferred where it is visible,
      but Flatpak refuses to export any file whose name is not prefixed
      with the app id, and the icon naming spec requires exactly that name
      - so inside a Flatpak the collection would otherwise draw blank.
      generic-icon names an icon from the user's theme, which needs no
      exporting; package-x-generic is the closest of the values the spec
      permits, a bundle of files rather than a document.
    -->
    <generic-icon name="package-x-generic"/>
  </mime-type>
</mime-info>
