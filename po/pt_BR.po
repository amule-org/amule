msgid ""
"aMule daemon (amuled.exe) appears to be running from $INSTDIR.\r\n"
"Please stop it and try again."
msgstr ""
"O daemon aMule (amuled.exe) parece estar rodando de $INSTDIR.\r\n"
"Por favor, pare-o e tente novamente."

