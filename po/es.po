#: packaging/windows/installer_strings.c
msgid "aMule (required)"
msgstr "aMule (obligatorio)"

#: packaging/windows/installer_strings.c
msgid "Desktop shortcut"
msgstr "Acceso directo en el escritorio"

#: packaging/windows/installer_strings.c
