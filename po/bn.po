msgstr "একটি গ্লোবাল অনুসন্ধান নির্বাহ করুন।"

#: src/TextClient.cpp
msgid "Execute a local search"
msgstr "একটি স্থানীয় অনুসন্ধান নির্বাহ করুন"

#: src/TextClient.cpp
msgid "Execute a kad search"
msgstr "একটি kad অনুসন্ধান নির্বাহ করুন"

#: src/TextClient.cpp
#, fuzzy
msgid "Execute an eD2k and Kad search"
msgstr "একটি kad অনুসন্ধান নির্বাহ করুন"

#: src/TextClient.cpp
msgid "Show the results of a search."
msgstr "একটি অনুসন্ধানের ফলাফল দেখান।"

#: src/TextClient.cpp
msgid ""
"Return the results of a search.\n"
"Optionally takes a search id (from 'search ...'); with no id, returns the results of the most recently started search.\n"
