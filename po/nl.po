#: packaging/windows/installer_strings.c
msgid "aMule (required)"
msgstr "aMule (vereist)"

#: packaging/windows/installer_strings.c
msgid "Desktop shortcut"
msgstr "Bureaubladsnelkoppeling"

#: packaging/windows/installer_strings.c
msgid "Start aMule when I log in"
msgstr "aMule starten bij aanmelden"

#: packaging/windows/installer_strings.c
msgid "Associate .emulecollection files"
msgstr ".emulecollection-bestanden toekennen"

#: packaging/windows/installer_strings.c
msgid "Uninstall"
msgstr "Verwijderen"

#: packaging/windows/installer_strings.c
msgid "Remove user data (config, ED2K servers, Kad nodes, partfiles)"
msgstr "Gebruikersgegevens verwijderen (configuratie, ED2K-servers, Kad-nodes, partbestanden)"

#: packaging/windows/installer_strings.c
msgid "aMule application files (required)."
msgstr "aMule-toepassingsbestanden (vereist)."

#: packaging/windows/installer_strings.c
msgid "Place an aMule shortcut on the desktop."
msgstr "Plaats een aMule-snelkoppeling op het bureaublad."

#: packaging/windows/installer_strings.c
msgid "Launch aMule automatically when the current user logs in (per-user setting)."
msgstr "aMule automatisch starten wanneer de huidige gebruiker zich aanmeldt (instelling per gebruiker)."

#: packaging/windows/installer_strings.c
msgid "Adds aMule to the \"Open with\" list for .emulecollection files, and makes it the default if no other program has claimed them. Opening a collection queues every eD2k link it contains."
msgstr "Voegt aMule toe aan de lijst \"Openen met\" voor .emulecollection-bestanden en maakt het de standaard als geen ander programma deze heeft geclaimd. Het openen van een collectie zet elke eD2k-link die deze bevat in de wachtrij."

#: packaging/windows/installer_strings.c
msgid "Remove aMule application files, Start Menu / desktop shortcuts, autostart Run-key entry, URL scheme registrations, and Add/Remove Programs entry (required)."
msgstr "aMule-toepassingsbestanden, snelkoppelingen in het Startmenu/op het bureaublad, het autostart-Run-sleutelitem, URL-schemaregistraties en het item in Programma's toevoegen of verwijderen (vereist)."

#: packaging/windows/installer_strings.c
msgid "Permanently delete %APPDATA%\\aMule for the current user (aMule.conf, ED2K server list, Kad nodes, partfiles, IP filters, friends list). Leave unchecked to keep your settings."
msgstr "Verwijder %APPDATA%\\aMule voor de huidige gebruiker permanent (aMule.conf, ED2K-serverlijst, Kad-nodes, partbestanden, IP-filters, vriendenlijst). Laat dit uitgeschakeld om uw instellingen te behouden."

#: packaging/windows/installer_strings.c
msgid ""
"aMule appears to be running from $INSTDIR.\r\n"
"Please close aMule (and aMuleD / aMuleGUI) and try again."
msgstr ""
"aMule lijkt te worden uitgevoerd vanuit $INSTDIR.\n"
"Sluit aMule (en aMuleD / aMuleGUI) en probeer het opnieuw."

#: packaging/windows/installer_strings.c
msgid ""
"aMule daemon (amuled.exe) appears to be running from $INSTDIR.\r\n"
"Please stop it and try again."
msgstr ""
"De aMule-daemon (amuled.exe) lijkt te worden uitgevoerd vanuit $INSTDIR.\n"
"Stop deze en probeer het opnieuw."

#: packaging/windows/installer_strings.c
msgid "Removing previous aMule installation at $0..."
msgstr "Vorige aMule-installatie op $0 wordt verwijderd..."

#: packaging/windows/installer_strings.c
msgid ""
"Could not remove the previous aMule installation at $0.\r\n"
"Please close any running aMule processes and try again, or uninstall the previous version manually first."
msgstr ""
"Kon de vorige aMule-installatie op $0 niet verwijderen.\n"
"Sluit alle actieve aMule-processen en probeer het opnieuw, of verwijder eerst handmatig de vorige versie."

#: packaging/windows/installer_strings.c
msgid "aMule appears to be running. Please close it and re-run the uninstaller."
msgstr "aMule lijkt te worden uitgevoerd. Sluit het en voer het verwijderprogramma opnieuw uit."

#: packaging/windows/installer_strings.c
msgid "Removing user data at $APPDATA\\aMule..."
msgstr "Gebruikersgegevens op $APPDATA\\aMule worden verwijderd..."

