#: packaging/windows/installer_strings.c
msgid "aMule (required)"
msgstr "aMule (vyžadováno)"

#: packaging/windows/installer_strings.c
msgid "Desktop shortcut"
msgstr "Zkratka plochy"

#: packaging/windows/installer_strings.c
msgid "Start aMule when I log in"
msgstr "Spustit aMule po přihlášení"

#: packaging/windows/installer_strings.c
msgid "Associate .emulecollection files"
msgstr "Přidružit soubory .emulecollection"

#: packaging/windows/installer_strings.c
msgid "Uninstall"
msgstr "Odinstalace"

#: packaging/windows/installer_strings.c
msgid "Remove user data (config, ED2K servers, Kad nodes, partfiles)"
msgstr "Odstranit uživatelská data (konfigurace, ED2K servery, Kad uzly, dočasné soubory)"

#: packaging/windows/installer_strings.c
msgid "aMule application files (required)."
msgstr "Soubory aplikace aMule (povinné)."

#: packaging/windows/installer_strings.c
msgid "Place an aMule shortcut on the desktop."
msgstr "Umístit zástupce aMule na plochu."

#: packaging/windows/installer_strings.c
msgid "Launch aMule automatically when the current user logs in (per-user setting)."
msgstr "Automaticky spustit aMule při přihlášení aktuálního uživatele (nastavení pro jednotlivého uživatele)."

#: packaging/windows/installer_strings.c
msgid "Adds aMule to the \"Open with\" list for .emulecollection files, and makes it the default if no other program has claimed them. Opening a collection queues every eD2k link it contains."
msgstr "Přidá aMule do seznamu „Otevřít pomocí“ pro soubory .emulecollection a nastaví jej jako výchozí, pokud je nepřevzal žádný jiný program. Otevřením kolekce se do fronty zařadí každý eD2k odkaz, který obsahuje."

#: packaging/windows/installer_strings.c
msgid "Remove aMule application files, Start Menu / desktop shortcuts, autostart Run-key entry, URL scheme registrations, and Add/Remove Programs entry (required)."
msgstr "Odstranit soubory aplikace aMule, zástupce v nabídce Start / na ploše, položku Run-key pro automatické spuštění, registrace schémat URL a položku v Přidat nebo odebrat programy (vyžadováno)."

#: packaging/windows/installer_strings.c
msgid "Permanently delete %APPDATA%\\aMule for the current user (aMule.conf, ED2K server list, Kad nodes, partfiles, IP filters, friends list). Leave unchecked to keep your settings."
msgstr "Trvale smazat %APPDATA%\\aMule pro aktuálního uživatele (aMule.conf, seznam ED2K serverů, Kad uzly, dočasné soubory, IP filtry, seznam přátel). Ponechte nezaškrtnuté, chcete-li si zachovat svá nastavení."

#: packaging/windows/installer_strings.c
msgid ""
"aMule appears to be running from $INSTDIR.\n"
"Please close aMule (and aMuleD / aMuleGUI) and try again."
msgstr ""
"Zdá se, že aMule je spuštěn z $INSTDIR.\n"
"Zavřete prosím aMule (a aMuleD / aMuleGUI) a zkuste to znovu."

#: packaging/windows/installer_strings.c
msgid ""
"aMule daemon (amuled.exe) appears to be running from $INSTDIR.\n"
"Please stop it and try again."
msgstr ""
"Zdá se, že daemon aMule (amuled.exe) je spuštěn z $INSTDIR.\n"
"Zastavte jej prosím a zkuste to znovu."

#: packaging/windows/installer_strings.c
msgid "Removing previous aMule installation at $0..."
msgstr "Odstraňuji předchozí instalaci aMule na $0..."

#: packaging/windows/installer_strings.c
msgid ""
"Could not remove the previous aMule installation at $0.\n"
"Please close any running aMule processes and try again, or uninstall the previous version manually first."
msgstr ""
"Nepodařilo se odstranit předchozí instalaci aMule na $0.\n"
"Zavřete prosím všechny běžící procesy aMule a zkuste to znovu, nebo nejprve ručně odinstalujte předchozí verzi."

#: packaging/windows/installer_strings.c
msgid "aMule appears to be running. Please close it and re-run the uninstaller."
msgstr "Zdá se, že aMule je spuštěn. Zavřete jej prosím a spusťte odinstalační program znovu."

#: packaging/windows/installer_strings.c
msgid "Removing user data at $APPDATA\\aMule..."
msgstr "Odstraňuji uživatelská data z $APPDATA\\aMule..."

