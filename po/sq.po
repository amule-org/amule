#: src/TextClient.cpp
msgid "The given value must be 1/ON (enable) or 0/OFF (disable).\n"
msgstr "Vlera e dhënë duhet të jetë 1/ON (aktivizo) ose 0/OFF (çaktivizo).\n"

#: src/TextClient.cpp
