#: packaging/windows/installer_strings.c
msgid "aMule (required)"
msgstr "aMule (i kërkuar)"

#: packaging/windows/installer_strings.c
msgid "Desktop shortcut"
msgstr "Shkurtore në desktop"

#: packaging/windows/installer_strings.c
msgid "Start aMule when I log in"
msgstr "Nis aMule kur hyj"

#: packaging/windows/installer_strings.c
msgid "Associate .emulecollection files"
msgstr "Shoqëro skedarët .emulecollection"

#: packaging/windows/installer_strings.c
msgid "Uninstall"
msgstr "Çinstalo"

#: packaging/windows/installer_strings.c
msgid "Remove user data (config, ED2K servers, Kad nodes, partfiles)"
msgstr "Hiq të dhënat e përdoruesit (konfigurimi, serverët ED2K, nyjet Kad, skedarët e pjesshëm)"

#: packaging/windows/installer_strings.c
msgid "aMule application files (required)."
msgstr "Skedarët e aplikacionit aMule (të kërkuar)."

#: packaging/windows/installer_strings.c
msgid "Place an aMule shortcut on the desktop."
msgstr "Vendos një shkurtore aMule në desktop."

#: packaging/windows/installer_strings.c
msgid "Launch aMule automatically when the current user logs in (per-user setting)."
msgstr "Nis aMule automatikisht kur përdoruesi aktual hyn (cilësim për çdo përdorues)."

#: packaging/windows/installer_strings.c
msgid "Adds aMule to the \"Open with\" list for .emulecollection files, and makes it the default if no other program has claimed them. Opening a collection queues every eD2k link it contains."
msgstr "Shton aMule te lista \"Hap me\" për skedarët .emulecollection, dhe e bën atë të parazgjedhur nëse asnjë program tjetër nuk i ka pretenduar. Hapja e një koleksioni vendos në radhë çdo lidhje eD2k që përmban."

#: packaging/windows/installer_strings.c
msgid "Remove aMule application files, Start Menu / desktop shortcuts, autostart Run-key entry, URL scheme registrations, and Add/Remove Programs entry (required)."
msgstr "Hiq skedarët e aplikacionit aMule, shkurtoret e Start Menu / desktopit, hyrjen Run-key të nisjes automatike, regjistrimet e skemës URL, dhe hyrjen Add/Remove Programs (e kërkuar)."

#: packaging/windows/installer_strings.c
msgid "Permanently delete %APPDATA%\\aMule for the current user (aMule.conf, ED2K server list, Kad nodes, partfiles, IP filters, friends list). Leave unchecked to keep your settings."
msgstr "Fshi përgjithmonë %APPDATA%\\aMule për përdoruesin aktual (aMule.conf, lista e serverëve ED2K, nyjet Kad, skedarët e pjesshëm, filtrat IP, lista e shokëve). Lëreni të pashenjuar për të ruajtur cilësimet tuaja."

#: packaging/windows/installer_strings.c
msgid ""
"aMule appears to be running from $INSTDIR.\n"
"Please close aMule (and aMuleD / aMuleGUI) and try again."
msgstr ""

