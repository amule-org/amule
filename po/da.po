msgid "Reload the given object."
msgstr "Genindlæs det angivne objekt."

#: src/TextClient.cpp
msgid "Reload shared files list."
msgstr "Genindlæs listen over delte filer."

#: src/TextClient.cpp
msgid "Reload IP filtering table."
msgstr "Genindlæs IP-filtreringstabel."

#: src/TextClient.cpp
msgid "Reload current IP filtering table."
msgstr "Genindlæs den aktuelle IP-filtreringstabel."

#: src/TextClient.cpp
msgid "Update IP filtering table from URL."
msgstr "Opdater IP-filtreringstabel fra URL."

#: src/TextClient.cpp
msgid "If URL is omitted the URL from the preferences is used."
msgstr "Hvis URL udelades, bruges URL'en fra indstillingerne."

#: src/TextClient.cpp
msgid "Connect to the network."
msgstr "Opret forbindelse til netværket."

#: src/TextClient.cpp
msgid ""
"This will connect to all networks that are enabled in Preferences.\n"
"You may also optionally specify a server address in IP:Port form, to connect to\n"
"that server only. The IP must be a dotted decimal IPv4 address,\n"
"or a resolvable DNS name."
msgstr ""
"Dette vil oprette forbindelse til alle netværk, der er aktiveret i indstillingerne.\n"
"Du kan også valgfrit angive en serveradresse i formatet IP:Port for kun at oprette\n"
"forbindelse til den pågældende server. IP-adressen skal være en decimal IPv4-adresse\n"
"med punktummer, eller et DNS-navn der kan slås op."

#: src/TextClient.cpp
msgid "Connect to eD2k only."
msgstr "Opret kun forbindelse til eD2k."

#: src/TextClient.cpp
msgid "Connect to Kad only."
msgstr "Opret kun forbindelse til Kad."

#: src/TextClient.cpp
msgid "Disconnect from the network."
msgstr "Afbryd forbindelsen til netværket."

#: src/TextClient.cpp
msgid "This will disconnect from all networks that are currently connected.\n"
msgstr "Dette vil afbryde forbindelsen til alle netværk, der aktuelt er forbundet.\n"

#: src/TextClient.cpp
msgid "Disconnect from eD2k only."
msgstr "Afbryd kun forbindelsen til eD2k."

#: src/TextClient.cpp
msgid "Disconnect from Kad only."
msgstr "Afbryd kun forbindelsen til Kad."

#: src/TextClient.cpp
msgid "Add an eD2k or magnet link to core."
msgstr "Tilføj et eD2k- eller magnetlink til kernen."

#: src/TextClient.cpp
msgid ""
"The eD2k link to be added can be:\n"
"*) a file link (ed2k://|file|...), it will be added to the download queue,\n"
"*) a server link (ed2k://|server|...), it will be added to the server list,\n"
"*) or a serverlist link, in which case all servers in the list will be added to the\n"
"   server list.\n"
"\n"
"The magnet link must contain the eD2k hash and file length.\n"
msgstr ""
"Det eD2k-link, der skal tilføjes, kan være:\n"
"*) et fillink (ed2k://|file|...), det tilføjes til downloadkøen,\n"
"*) et serverlink (ed2k://|server|...), det tilføjes til serverlisten,\n"
"*) eller et serverlistelink, i hvilket tilfælde alle servere i listen tilføjes til\n"
"   serverlisten.\n"
"\n"
"Magnetlinket skal indeholde eD2k-hashen og fillængden.\n"

#: src/TextClient.cpp
