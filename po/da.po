msgstr "Slå IP-filtrering til for klienter."

#: src/TextClient.cpp
msgid "Turn IP filtering off for clients."
msgstr "Slå IP-filtrering fra for klienter."

#: src/TextClient.cpp
msgid "Enable/Disable IP filtering for servers."
msgstr "Aktiver/deaktiver IP-filtrering for servere."

