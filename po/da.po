msgstr ""
"Gyldige filtreringsniveauer er i intervallet 0-255, og standardværdien (den\n"
"oprindelige) er 127.\n"

#: src/TextClient.cpp
msgid "Set bandwidth limits."
msgstr "Angiv båndbreddegrænser."

#: src/TextClient.cpp
msgid "The value given to these commands has to be in kilobytes/sec.\n"
msgstr "Værdien, der angives til disse kommandoer, skal være i kilobyte/sek.\n"

#: src/TextClient.cpp
msgid "Set upload bandwidth limit."
msgstr "Angiv grænse for uploadbåndbredde."

#: src/TextClient.cpp
msgid "The given value must be in kilobytes/sec.\n"
msgstr "Den angivne værdi skal være i kilobyte/sek.\n"

#: src/TextClient.cpp
msgid "Set download bandwidth limit."
