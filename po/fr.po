msgstr "Activer ou désactiver la rotation de sources pour « endgame »."

#: src/TextClient.cpp
msgid "The given value must be 1/ON (enable) or 0/OFF (disable).\n"
msgstr "La valeur donnée doit être 1/ON (activer) ou bien 0/OFF (désactiver).\n"

