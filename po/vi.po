#: packaging/windows/installer_strings.c
msgid "Start aMule when I log in"
msgstr "Khởi động aMule khi tôi đăng nhập"

#: packaging/windows/installer_strings.c
msgid "Associate .emulecollection files"
msgstr "Liên kết tệp .emulecollection"

#: packaging/windows/installer_strings.c
msgid "Uninstall"
msgstr "Gỡ cài đặt"

#: packaging/windows/installer_strings.c
msgid "Remove user data (config, ED2K servers, Kad nodes, partfiles)"
msgstr "Xóa dữ liệu người dùng (cấu hình, máy chủ ED2K, nút Kad, partfile)"

#: packaging/windows/installer_strings.c
msgid "aMule application files (required)."
msgstr "Tệp ứng dụng aMule (bắt buộc)."

#: packaging/windows/installer_strings.c
msgid "Place an aMule shortcut on the desktop."
msgstr "Đặt lối tắt aMule trên màn hình nền."

#: packaging/windows/installer_strings.c
msgid "Launch aMule automatically when the current user logs in (per-user setting)."
msgstr "Tự động khởi chạy aMule khi người dùng hiện tại đăng nhập (cài đặt theo từng người dùng)."

#: packaging/windows/installer_strings.c
msgid "Adds aMule to the \"Open with\" list for .emulecollection files, and makes it the default if no other program has claimed them. Opening a collection queues every eD2k link it contains."
msgstr "Thêm aMule vào danh sách \"Mở bằng\" cho tệp .emulecollection, và đặt làm mặc định nếu chưa có chương trình nào khác nhận loại tệp này. Mở một bộ sưu tập sẽ đưa vào hàng đợi mọi liên kết eD2k mà nó chứa."

#: packaging/windows/installer_strings.c
msgid "Remove aMule application files, Start Menu / desktop shortcuts, autostart Run-key entry, URL scheme registrations, and Add/Remove Programs entry (required)."
msgstr "Xóa các tệp ứng dụng aMule, lối tắt trong Start Menu / màn hình nền, mục Run-key tự khởi động, đăng ký giao thức URL, và mục trong Add/Remove Programs (bắt buộc)."

#: packaging/windows/installer_strings.c
msgid "Permanently delete %APPDATA%\\aMule for the current user (aMule.conf, ED2K server list, Kad nodes, partfiles, IP filters, friends list). Leave unchecked to keep your settings."
msgstr "Xóa vĩnh viễn %APPDATA%\\aMule cho người dùng hiện tại (aMule.conf, danh sách máy chủ ED2K, nút Kad, partfile, bộ lọc IP, danh sách bạn bè). Bỏ chọn để giữ lại cài đặt của bạn."

#: packaging/windows/installer_strings.c
msgid ""
"aMule appears to be running from $INSTDIR.\n"
"Please close aMule (and aMuleD / aMuleGUI) and try again."
msgstr ""

#: packaging/windows/installer_strings.c
msgid ""
"aMule daemon (amuled.exe) appears to be running from $INSTDIR.\n"
"Please stop it and try again."
msgstr ""

#: packaging/windows/installer_strings.c
msgid "Removing previous aMule installation at $0..."
msgstr "Đang xóa bản cài đặt aMule trước đó tại $0..."

#: packaging/windows/installer_strings.c
msgid ""
"Could not remove the previous aMule installation at $0.\n"
"Please close any running aMule processes and try again, or uninstall the previous version manually first."
msgstr ""

#: packaging/windows/installer_strings.c
msgid "aMule appears to be running. Please close it and re-run the uninstaller."
msgstr "aMule dường như đang chạy. Vui lòng đóng nó và chạy lại trình gỡ cài đặt."

#: packaging/windows/installer_strings.c
msgid "Removing user data at $APPDATA\\aMule..."
msgstr "Đang xóa dữ liệu người dùng tại $APPDATA\\aMule..."

